NODE_ENV=development
PORT=5000
# The single origin the browser app is served from. It is both the CORS
# allowlist and the origin every state-changing request is checked against, so
# it is required outside development and test — a deploy that falls back to
# localhost fails closed, but it fails.
CLIENT_ORIGIN=http://localhost:3000
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# Consumed by docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iamgeorgia
POSTGRES_PORT=5432

# Consumed by the Express app and the Prisma CLI — must match the values above
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iamgeorgia

# Consumed by the auth system. APP_URL is where the browser reaches the front
# end; every invitation and activation link in an email is built from it.
# AUTH_TOKEN_PEPPER is mixed into the hash of every token, so a stolen database
# dump on its own cannot be turned back into a working link. All three are
# required in production; the pepper falls back to a fixed development value.
APP_URL=http://localhost:3000
AUTH_TOKEN_PEPPER=change-me-to-32-random-bytes

# Consumed by the mailer.
#   smtp    — send through a real server (the production default)
#   log     — print the message, links included, through the app logger
#   capture — collect into an in-memory outbox, used by the test suite
# SMTP_HOST, SMTP_USER and SMTP_PASS are required outside development and test.
# Any other transport name refuses to boot rather than falling back to log.
MAIL_TRANSPORT=log
MAIL_FROM=I am Georgia <no-reply@iamgeorgia.travel>
# MAIL_REPLY_TO=partners@iamgeorgia.travel
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# How long a send may wait to connect to the relay, and for it to answer.
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=30000

# Required outside development and test, because neither value is safe as a
# default: `false` behind a load balancer makes every request appear to come
# from the proxy's IP and the per-IP limits protect nothing, while `true` in
# front of one lets a client spoof its own address through X-Forwarded-For.
# Accepts true/false, a hop count (1) or a named subnet (loopback).
TRUST_PROXY=false

# Where the rate limiters keep their counters. Unset, they count in this
# process's memory — correct for a single instance, wrong for two: a pair
# behind a load balancer each allow the full limit, and a restart forgets every
# counter. Set this as soon as there is more than one instance.
# REDIS_URL=redis://localhost:6379

# Optional auth tuning (defaults shown, in milliseconds).
# AUTH_COOKIE_NAME=iag_session
# Leave unset locally: localhost:3000 and localhost:5000 already share cookies.
# Deployed, it is the domain the site and the API share — see
# .env.production.example.
# AUTH_COOKIE_DOMAIN=
# SESSION_TTL_MS=2592000000
# How far SESSION_TTL_MS may slide forward, measured from when the session was
# created. This is the ceiling that actually ends a session: without it an
# account used once a fortnight stays signed in forever.
# SESSION_ABSOLUTE_TTL_MS=7776000000
# INVITATION_TTL_MS=604800000
# ACTIVATION_TTL_MS=172800000
# PASSWORD_RESET_TTL_MS=3600000

# Optional rate limit tuning (defaults shown, in attempts per window).
# Failed sign-ins per 15 minutes, per IP and account.
# AUTH_LOGIN_LIMIT=10
# Invitation claims per hour, per IP.
# AUTH_REGISTRATION_LIMIT=5
# Token lookups and link requests per 15 minutes, per IP.
# AUTH_TOKEN_LOOKUP_LIMIT=30
# Wrong current-password attempts per 15 minutes, per signed-in user.
# AUTH_PASSWORD_CHANGE_LIMIT=5
# Reset links per 15 minutes for one address, wherever asked for from.
# AUTH_FORGOT_PASSWORD_LIMIT=5
# Staff and team invitations per 15 minutes, per signed-in inviter.
# AUTH_INVITE_LIMIT=30
# Requests per minute per IP, across everything except /health.
# RATE_LIMIT_GLOBAL=100

# Members a partner may have, invited ones included.
# PARTNER_TEAM_MAX=25

# Finance (defaults shown). Instalments fall due at the cutoff time in the
# supplier's timezone; a guest without an account owes on the day of booking.
# FINANCE_DEFAULT_TIMEZONE=Asia/Tbilisi
# FINANCE_CUTOFF_TIME=10:00
# FINANCE_GUEST_DUE_DAYS=0

# Optional tuning (defaults shown). DATABASE_POOL_MAX is per process, and
# Postgres allows 100 connections in total by default.
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# SHUTDOWN_TIMEOUT_MS=10000
# How long a client may take to send a whole request before the socket is
# dropped. Node's default is five minutes.
# REQUEST_TIMEOUT_MS=30000

# --- Hotel module -----------------------------------------------------------
# How long checkout holds a room, and how often expired holds are swept back
# into availability. The sweep interval is the worst-case delay before an
# abandoned checkout stops blocking the last room.
HOTEL_HOLD_TTL_MS=900000
HOTEL_HOLD_SWEEP_INTERVAL_MS=30000

# How often confirmed stays whose check-out has passed roll to COMPLETED.
# Hourly by default; an order with a hotel in it waits on this to complete.
HOTEL_COMPLETION_SWEEP_INTERVAL_MS=3600000

# Signs the offer tokens search hands out so a client cannot edit a price on
# its way into checkout. Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HOTEL_OFFER_TOKEN_SECRET=
HOTEL_OFFER_TOKEN_TTL_MS=1800000

# Markup applied to net rates when no partner-specific rule exists, in basis
# points: 1500 = 15%.
HOTEL_DEFAULT_MARKUP_BPS=1500

# Guard rails on the bulk inventory/rate editors and on stay length.
HOTEL_MAX_BULK_DAYS=730
HOTEL_MAX_STAY_NIGHTS=30
HOTEL_BOOKING_HORIZON_DAYS=540

# --- Transfer module --------------------------------------------------------
# Signs the quote tokens transfer search hands out. Required in production, and
# separate from the hotel secret so either can be rotated on its own. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TRANSFER_QUOTE_TOKEN_SECRET=
TRANSFER_QUOTE_TOKEN_TTL_MS=1800000

# The same again for tour offers and package quotes: each product signs its own
# tokens with its own secret, so any one can be rotated without touching the
# others. All four are required in production. Generate as above.
TOUR_OFFER_TOKEN_SECRET=
TOUR_OFFER_TOKEN_TTL_MS=1800000
PACKAGE_OFFER_TOKEN_SECRET=
PACKAGE_OFFER_TOKEN_TTL_MS=1800000

# Markup applied to net fares when no partner-specific rule exists, in basis
# points: 1500 = 15%.
TRANSFER_DEFAULT_MARKUP_BPS=1500

# The distance engine: how much longer a road is than a straight line, the
# blended average speed, and the fixed loading overhead on every journey.
TRANSFER_ROAD_FACTOR=1.3
TRANSFER_AVERAGE_SPEED_KMH=62
TRANSFER_FIXED_OVERHEAD_MINUTES=12

# Night pick-ups, and what they cost. Hours are local to the pick-up point.
TRANSFER_NIGHT_FROM_HOUR=22
TRANSFER_NIGHT_UNTIL_HOUR=6
TRANSFER_NIGHT_SURCHARGE_BPS=2000

# Booking window guard rails.
TRANSFER_BOOKING_HORIZON_DAYS=540
TRANSFER_MINIMUM_NOTICE_MINUTES=180
TRANSFER_MAX_PASSENGERS=50

# Dispatch: how a leg claims a driver's and a car's time, and what a driver
# may do when. Buffers are stored on each assignment when it is written, so
# changing them here affects new assignments only.
TRANSFER_DISPATCH_PRE_BUFFER_MINUTES=45
TRANSFER_DISPATCH_POST_BUFFER_MINUTES=30
# false = assigning a driver is accepting on their behalf.
TRANSFER_DISPATCH_REQUIRE_ACCEPTANCE=true
TRANSFER_DISPATCH_MAX_EARLY_START_MINUTES=240
TRANSFER_DISPATCH_LATE_DECLINE_HOURS=12
TRANSFER_DISPATCH_NO_SHOW_WAIT_MINUTES=30
TRANSFER_DISPATCH_NO_SHOW_WAIT_MINUTES_AIRPORT=60
# false = a driver's no-show report closes the leg without an operations check.
TRANSFER_DISPATCH_NO_SHOW_REQUIRES_CONFIRMATION=true
# Hours before pick-up at which the driver's phone number is shown to the
# partner and the passenger.
TRANSFER_DISPATCH_CONTACT_REVEAL_HOURS=24
TRANSFER_RATING_WINDOW_DAYS=30
# Signs the rating links emailed to passengers. Required in production.
TRANSFER_RATING_TOKEN_SECRET=
# Where the "leg still has no driver" alert is emailed. Optional.
TRANSFER_OPS_EMAIL=
TRANSFER_OUTBOX_DRAIN_INTERVAL_MS=5000
TRANSFER_REMINDER_SWEEP_INTERVAL_MS=60000

# --- Media storage (Cloudflare R2, S3-compatible) ---------------------------
# `s3` when MEDIA_S3_ENDPOINT is set, `local` otherwise. Set it explicitly in
# production so a missing endpoint fails at boot instead of writing uploads to
# the container's disk, where the next deploy loses them.
# MEDIA_DRIVER=s3
# R2 endpoint looks like https://<account-id>.r2.cloudflarestorage.com
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BUCKET=iag-public
MEDIA_PRIVATE_BUCKET=iag-private

# Timeouts and retries against the bucket. The SDK's defaults are unbounded.
# MEDIA_S3_REQUEST_TIMEOUT_MS=30000
# MEDIA_S3_CONNECTION_TIMEOUT_MS=5000
# MEDIA_S3_MAX_ATTEMPTS=3

# Public object keys are appended to this to form a URL at serialization time.
# The database stores keys, never URLs, so changing CDN is a config change.
MEDIA_PUBLIC_BASE_URL=

# Private files are only reachable through a signed URL issued after an
# authorization check. Kept short: it is handed to one browser, once.
MEDIA_SIGNED_URL_TTL_SECONDS=60
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_DOCUMENT_BYTES=26214400
