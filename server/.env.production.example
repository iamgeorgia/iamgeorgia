# Production environment for the API.
#
# Every variable here is either required by config.js outside development and
# test, or one you will want to set on day one. Copy it into the host's
# environment (Render dashboard, `docker compose --env-file`, a secrets
# manager) — never commit the filled-in copy.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# The one origin the browser app is served from. It is the CORS allowlist and
# the origin every state-changing request is checked against.
CLIENT_ORIGIN=https://iamgeorgia.travel
# Where emailed links point. Usually the same as CLIENT_ORIGIN.
APP_URL=https://iamgeorgia.travel

# The domain the site and the API share, so the session cookie is sent to the
# site too — the panels check the session while rendering there. The narrowest
# shared domain of THIS environment: `iamgeorgia.travel` for iamgeorgia.travel +
# api.iamgeorgia.travel, `preview.iamgeorgia.com.ge` for a preview on
# preview.iamgeorgia.com.ge + api.preview.iamgeorgia.com.ge. Leave it unset only
# when the site and the API are served from one host.
AUTH_COOKIE_DOMAIN=iamgeorgia.travel

# 1 = exactly one trusted proxy in front of the API (Render, Fly, Caddy, nginx,
# a single load balancer). Never `true` behind a proxy, never `false` behind one.
TRUST_PROXY=1

# Shared with the Next.js client (same name there). The client renders search
# and the catalogue on each visitor's behalf, so all of its calls arrive from
# one address; with this token it names the visitor (`x-visitor-address`) and
# the per-IP rate limits count that visitor rather than the client server.
# Without it the whole site shares one 30-searches-a-minute bucket.
API_CLIENT_TOKEN=change-me-to-a-long-random-string

# Dated hotel/tour searches per minute per visitor (default 30).
# RATE_LIMIT_SEARCH=30

# Internal connection string from the database host. Add `?sslmode=require`
# only when connecting over the public internet.
DATABASE_URL=postgresql://user:password@host:5432/iamgeorgia
# Per process. Postgres allows 100 connections by default; a Render Basic
# instance allows fewer. pool x instances must stay under that.
DATABASE_POOL_MAX=10

# Secrets — one each, all different.
AUTH_TOKEN_PEPPER=
HOTEL_OFFER_TOKEN_SECRET=
TRANSFER_QUOTE_TOKEN_SECRET=
TOUR_OFFER_TOKEN_SECRET=
PACKAGE_OFFER_TOKEN_SECRET=
TRANSFER_RATING_TOKEN_SECRET=

# Mail. A transactional provider (Resend, Postmark, SES, Brevo) — not a
# personal mailbox, which will be rate limited or flagged within a day.
MAIL_TRANSPORT=smtp
MAIL_FROM=I am Georgia <no-reply@iamgeorgia.travel>
MAIL_REPLY_TO=hello@iamgeorgia.travel
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where "a transfer leg still has no driver" alerts go.
TRANSFER_OPS_EMAIL=ops@iamgeorgia.travel
# The finance mailbox: supplier payment reminders, overdue alerts and overdue
# bills go here beside the in-app notices. The schedule has defaults
# (7,3,1,0 days before; overdue daily) and is only set to change it.
FINANCE_OPS_EMAIL=finance@iamgeorgia.travel
# FINANCE_REMINDER_OFFSET_DAYS=7,3,1,0
# FINANCE_OVERDUE_REPEAT_DAYS=1

# Media on Cloudflare R2 (or any S3-compatible store). Two buckets: the public
# one sits behind a CDN URL, the private one is reachable only via signed URLs.
MEDIA_DRIVER=s3
MEDIA_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BUCKET=iamgeorgia-public-prod
MEDIA_PRIVATE_BUCKET=iamgeorgia-private-prod
# The public bucket's CDN URL (r2.dev or a custom domain). Also listed in
# client/next.config.ts under images.remotePatterns.
MEDIA_PUBLIC_BASE_URL=https://media.iamgeorgia.travel

# Set as soon as the API runs on more than one instance, so the rate limiters
# share their counters. Leave unset on a single instance.
# REDIS_URL=redis://host:6379

# The platform's termination grace period must be longer than this.
SHUTDOWN_TIMEOUT_MS=10000
