/// Everyone who can sign in. One table rather than separate admin and partner
/// tables: one login endpoint, one session mechanism, one unique email. Admins
/// carry no partnerId, partner roles always do — enforced by a CHECK constraint
/// added in the migration, because an admin attached to a company would be an
/// authorization bug that only surfaced at read time.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  /// Null until the invitee or invited admin sets one through an activation link.
  passwordHash String? @map("password_hash")
  role         Role

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  position  String?
  phone     String?

  /// The one user an admin corresponds with. Later a partner will have several
  /// employees; exactly one of them stays the primary contact.
  isPrimaryContact Boolean   @default(false) @map("is_primary_contact")
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at")

  /// Who created this account and when, for staff and team members invited by
  /// another user. Null for the CLI-made first admin and for partner owners
  /// who came through the onboarding invitation.
  invitedByUserId String?   @map("invited_by_user_id")
  invitedBy       User?     @relation("UserInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitedAt       DateTime? @map("invited_at")

  /// Set together with isActive=false; cleared on reactivation.
  deactivatedByUserId String?   @map("deactivated_by_user_id")
  deactivatedBy       User?     @relation("UserDeactivatedBy", fields: [deactivatedByUserId], references: [id], onDelete: SetNull)
  deactivatedAt       DateTime? @map("deactivated_at")

  usersInvited     User[] @relation("UserInvitedBy")
  usersDeactivated User[] @relation("UserDeactivatedBy")

  partnerId String?  @map("partner_id")
  partner   Partner? @relation("PartnerMembers", fields: [partnerId], references: [id], onDelete: Cascade)

  sessions          Session[]
  authTokens        AuthToken[]
  auditLogs         AuditLog[]
  invitationsSent   Invitation[]   @relation("InvitationInvitedBy")
  partnersApproved  Partner[]      @relation("PartnerApprovedBy")
  partnersRejected  Partner[]      @relation("PartnerRejectedBy")
  partnersSuspended Partner[]      @relation("PartnerSuspendedBy")
  partnersBlocked    Partner[]     @relation("PartnerBlockedBy")
  partnersTerminated Partner[]     @relation("PartnerTerminatedBy")
  contractsUploaded  Partner[]     @relation("PartnerContractUploadedBy")
  termsAccepted      Partner[]     @relation("PartnerTermsAcceptedBy")
  productAccessGiven PartnerProductAccess[] @relation("ProductAccessCreatedBy")
  filesUploaded     FileAsset[]    @relation("FileUploadedBy")
  bookingsMade      HotelBooking[] @relation("BookingBookedBy")
  holdsCreated      BookingHold[]  @relation("HoldCreatedBy")

  transferBookingsMade TransferBooking[] @relation("TransferBookingBookedBy")
  tourBookingsMade     TourBooking[]     @relation("TourBookingBookedBy")
  tourHoldsCreated     TourHold[]        @relation("TourHoldCreatedBy")

  /// The driver profile behind a DRIVER account, when one has been linked.
  driverProfile                 TransferDriver?                @relation("DriverUser")
  driversVerified               TransferDriver[]               @relation("DriverVerifiedBy")
  driverDocumentsUploaded       TransferDriverDocument[]       @relation("DriverDocumentUploadedBy")
  fleetVehicleDocumentsUploaded TransferFleetVehicleDocument[] @relation("FleetVehicleDocumentUploadedBy")
  transferAssignmentsMade       TransferAssignment[]           @relation("AssignmentAssignedBy")
  transferResourceBlocksCreated TransferResourceBlock[]        @relation("ResourceBlockCreatedBy")
  transferRatingsSubmitted      TransferDriverRating[]         @relation("RatingSubmittedBy")
  transferRatingsModerated      TransferDriverRating[]         @relation("RatingModeratedBy")
  notifications                 Notification[]                 @relation("NotificationRecipient")

  kosherProfilesLocked         HotelKosherProfile[]       @relation("KosherProfileLockedBy")
  kosherCertificationsVerified HotelKosherCertification[] @relation("KosherCertificationVerifiedBy")
  bookingRequestsAnswered      HotelBookingRequest[]      @relation("BookingRequestRespondedBy")
  hotelDocumentsUploaded       HotelDocument[]            @relation("HotelDocumentUploadedBy")

  serviceBookingsMade ServiceBooking[] @relation("ServiceBookingBookedBy")
  ordersMade          Order[]          @relation("OrderBookedBy")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  paymentsRecorded    PaymentRecord[]  @relation("PaymentRecordedBy")

  /// What the account may do comes from here, never from `role` alone: every
  /// role it holds, plus or minus the overrides written for it by name.
  /// `role` stays as the primary role, kept in step by a trigger, until the
  /// column goes.
  roles               UserRole[]               @relation("UserRoles")
  capabilityOverrides UserCapabilityOverride[] @relation("UserOverrides")
  approvalsRequested  ApprovalRequest[]        @relation("ApprovalRequestedBy")
  approvalsDecided    ApprovalRequest[]        @relation("ApprovalDecidedBy")

  @@index([partnerId])
  @@index([role])
  @@map("users")
}

/// An opaque server-side session. Kept in the database rather than signed into
/// a JWT so that suspending a partner ends its sessions on the next request
/// instead of whenever the token happens to expire.
model Session {
  id        String @id @default(cuid())
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?
  userAgent String?   @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use links that set a password: account activation and password reset.
model AuthToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique @map("token_hash")
  purpose   TokenPurpose

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// A partner company. Only `name` and `kind` are required, because an admin
/// drafting an invitation knows those and nothing else yet; the registration
/// schema requires the rest before a partner can reach PENDING_APPROVAL.
model Partner {
  id String @id @default(cuid())

  /// The public Partner ID, e.g. PTR-000001. Drawn from a Postgres sequence,
  /// immutable, and never the primary key — the id is an implementation detail
  /// that must not appear in a URL a partner quotes over the phone.
  reference String @unique

  name      String
  legalName String?       @map("legal_name")
  kind      PartnerKind
  status    PartnerStatus @default(INVITED)

  registrationNumber String? @unique @map("registration_number")
  legalAddress       String? @map("legal_address")
  city               String?
  country            String?
  phone              String?
  email              String?
  website            String?

  /// SocialLink[]
  socialLinks Json @default("[]") @map("social_links")
  /// PartnerDocument[]
  documents   Json @default("[]")

  /// Commission in basis points: 1000 = 10%. Integer for the same reason money
  /// is — 12.5% cannot be stored exactly as a float.
  commissionRateBps Int @default(1000) @map("commission_rate_bps")

  /// Internal, never returned to the partner.
  notes String?

  submittedAt DateTime? @map("submitted_at")

  approvedAt       DateTime? @map("approved_at")
  approvedByUserId String?   @map("approved_by_user_id")
  approvedByUser   User?     @relation("PartnerApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  rejectedAt       DateTime? @map("rejected_at")
  rejectedByUserId String?   @map("rejected_by_user_id")
  rejectedByUser   User?     @relation("PartnerRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  /// Shown to the applicant.
  rejectionReason  String?   @map("rejection_reason")
  /// Never leaves the admin panel.
  rejectionNote    String?   @map("rejection_note")

  suspendedAt       DateTime? @map("suspended_at")
  suspendedByUserId String?   @map("suspended_by_user_id")
  suspendedByUser   User?     @relation("PartnerSuspendedBy", fields: [suspendedByUserId], references: [id], onDelete: SetNull)
  suspensionReason  String?   @map("suspension_reason")

  users        User[]                  @relation("PartnerMembers")
  financial    PartnerFinancialDetail?
  invitations  Invitation[]
  hotels       Hotel[]                 @relation("PartnerHotels")
  files        FileAsset[]             @relation("PartnerFiles")
  bookings     HotelBooking[]          @relation("PartnerBookings")
  holds        BookingHold[]           @relation("PartnerHolds")
  pricingRules PricingRule[]           @relation("PartnerPricingRules")

  transferProviders TransferProvider[] @relation("PartnerTransferProviders")
  transferVehicles  TransferVehicle[]  @relation("PartnerTransferVehicles")
  transferBookings  TransferBooking[]  @relation("PartnerTransferBookings")

  tours        Tour[]        @relation("PartnerTours")
  tourBookings TourBooking[] @relation("PartnerTourBookings")
  tourHolds    TourHold[]    @relation("PartnerTourHolds")

  services         Service[]           @relation("PartnerServices")
  serviceBookings  ServiceBooking[]    @relation("PartnerServiceBookings")
  orders           Order[]             @relation("PartnerOrders")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  /// Days the partner has to pay a booking, counted from the anchor (D5: per partner).
  paymentDueDays   Int                 @default(14) @map("payment_due_days")
  paymentDueAnchor ReceivableDueAnchor @default(CONFIRMATION) @map("payment_due_anchor")
  paymentTermsNote String?             @map("payment_terms_note")

  /// How much the company may owe, open, in one currency. Null is no limit.
  /// Counts only that currency's open receivables; nothing is summed across
  /// exchange rates. BLOCK refuses the booking that would pass it; WARN lets
  /// it through and tells finance.
  creditLimitCents    Int?            @map("credit_limit_cents")
  creditLimitCurrency String?         @map("credit_limit_currency") @db.Char(3)
  creditLimitMode     CreditLimitMode @default(BLOCK) @map("credit_limit_mode")
  penalties           PenaltyEntry[]  @relation("PartnerPenalties")

  /// The signed contract, as a private file; approval waits for it unless
  /// `contractRequired` was switched off (partners approved before the gate
  /// existed, or on an admin's say-so, audited).
  contractAssetId          String?   @unique @map("contract_asset_id")
  contractAsset            FileAsset? @relation("PartnerContract", fields: [contractAssetId], references: [id], onDelete: SetNull)
  contractSignedAt         DateTime? @map("contract_signed_at")
  contractVersion          String?   @map("contract_version")
  contractUploadedAt       DateTime? @map("contract_uploaded_at")
  contractUploadedByUserId String?   @map("contract_uploaded_by_user_id")
  contractUploadedByUser   User?     @relation("PartnerContractUploadedBy", fields: [contractUploadedByUserId], references: [id], onDelete: SetNull)
  contractRequired         Boolean   @default(true) @map("contract_required")

  /// The platform terms the company last accepted. The portal is shut until
  /// this matches the current version.
  termsVersion          String?   @map("terms_version")
  termsAcceptedAt       DateTime? @map("terms_accepted_at")
  termsAcceptedByUserId String?   @map("terms_accepted_by_user_id")
  termsAcceptedByUser   User?     @relation("PartnerTermsAcceptedBy", fields: [termsAcceptedByUserId], references: [id], onDelete: SetNull)

  blockedAt         DateTime? @map("blocked_at")
  blockedByUserId   String?   @map("blocked_by_user_id")
  blockedByUser     User?     @relation("PartnerBlockedBy", fields: [blockedByUserId], references: [id], onDelete: SetNull)
  blockedReason     String?   @map("blocked_reason")
  terminatedAt      DateTime? @map("terminated_at")
  terminatedByUserId String?  @map("terminated_by_user_id")
  terminatedByUser  User?     @relation("PartnerTerminatedBy", fields: [terminatedByUserId], references: [id], onDelete: SetNull)
  terminatedReason  String?   @map("terminated_reason")

  productAccess PartnerProductAccess[] @relation("PartnerProductAccess")
  receivables      Receivable[]        @relation("PartnerReceivables")
  supplierPayables SupplierPayable[]   @relation("PartnerSupplierPayables")
  paymentRecords   PaymentRecord[]     @relation("PartnerPaymentRecords")

  @@index([status])
  @@index([country])
  @@index([createdAt])
  @@map("partners")
}

/// Bank details, in their own table so that the ordinary partner queries the
/// admin panel runs cannot return them by accident. Reaching an IBAN has to be
/// a deliberate join, which is exactly the property the requirement asks for.
model PartnerFinancialDetail {
  id String @id @default(cuid())

  partnerId String  @unique @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  iban          String
  swift         String
  bankName      String? @map("bank_name")
  accountHolder String? @map("account_holder")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("partner_financial_details")
}

/// A registration link bound to one email address. The row holds the hash of
/// the token; the token itself exists only in the URL that was emailed.
model Invitation {
  id        String @id @default(cuid())
  tokenHash String @unique @map("token_hash")

  /// The only address that may claim this invitation.
  email String

  /// Set when the admin drafted the company before inviting; null when the
  /// invitee will supply everything themselves.
  partnerId String?  @map("partner_id")
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  invitedByUserId String? @map("invited_by_user_id")
  invitedByUser   User?   @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  resentCount Int       @default(0) @map("resent_count")

  /// Partial company and contact fields the admin filled in, replayed into the
  /// registration form so the invitee does not retype them.
  prefill Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([partnerId])
  @@index([expiresAt])
  @@map("invitations")
}

/// Who did what, to which record, when. Deliberately not cascaded and not
/// foreign-keyed to its subject: the trail has to outlive the row.
model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction

  actorUserId String? @map("actor_user_id")
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Snapshot of the email, so the trail still names the actor after the
  /// account is deleted and actorUserId has been nulled.
  actorEmail  String  @map("actor_email")

  entityType String  @map("entity_type")
  entityId   String  @map("entity_id")
  summary    String
  /// Arbitrary detail: the fields that changed, the reason given, and so on.
  metadata   Json    @default("{}")
  ip         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Transfers — point-to-point ground transport.
//
// The shape differs from hotels in one decisive way, and the difference is
// deliberate: **there is no inventory and there are no holds.** A hotel sells a
// finite number of rooms on a finite number of nights, so availability has to
// be a counter defended by a CHECK constraint. A private transfer is dispatched
// by a supplier from an elastic fleet — subcontracting a second car is normal
// operations, not an oversell — so a per-day units table would be a fiction the
// booking flow then had to defend. What is real is a road that closes, and that
// is TransferBlackout.
//
// Pricing is two-tier. TransferRoutePrice holds what an admin has decided a
// named route costs in each vehicle class; anything with no row falls back to
// distance x per-km against the same maths the client prototype used. So the
// commercial catalogue is curated without any pair of points becoming
// unbookable, which is what would happen if only named routes were sellable.
// ---------------------------------------------------------------------------

/// Where a journey can start or end.
///
/// Kept separate from Destination rather than folded into it: an airport
/// terminal and a hotel forecourt are pick-up points, not places anyone browses
/// holidays by, and adding them to the destination tree would put them on
/// /destinations and into every hotel filter. The optional destinationId is the
/// join back, so "transfers to Kazbegi" still resolves.
enum TransferPointKind {
  AIRPORT
  CITY
  RESORT
  HOTEL
  LANDMARK
  STATION

  @@map("transfer_point_kind")
}

/// The commercial product tiers from the operator catalogue. Distinct from
/// TransferVehicleBody, which is what the vehicle physically is: a Comfort and
/// an Economy are both sedans and are sold at different prices.
enum TransferVehicleClass {
  ECONOMY
  COMFORT
  MINIVAN
  VAN
  GROUP
  JEEP_4X4
  VIP

  @@map("transfer_vehicle_class")
}

/// Spelled in lower case to match the client VehicleClass string union, which
/// selects the illustration in components/transfers/VehicleIllustration.tsx.
enum TransferVehicleBody {
  sedan
  suv
  minivan
  van
  bus

  @@map("transfer_vehicle_body")
}

/// Private hires the whole vehicle; shared sells a seat on a scheduled run.
/// The distinction is not cosmetic — it decides whether a fare is multiplied by
/// the party size.
enum TransferKind {
  PRIVATE
  SHARED

  @@map("transfer_kind")
}

/// Sales priority from the catalogue. Drives which routes are prerendered as
/// landing pages and which the panel surfaces first.
enum TransferRouteTier {
  TIER_1
  TIER_2
  TIER_3

  @@map("transfer_route_tier")
}

enum TransferRouteCategory {
  AIRPORT
  CITY
  RESORT
  TOURIST_ROUTE
  COMBINED

  @@map("transfer_route_category")
}

/// The same lifecycle as HotelStatus, and for the same reason: a route or a
/// vehicle with booking history is retired, never deleted.
enum TransferStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("transfer_status")
}

enum TransferBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@map("transfer_booking_status")
}

enum TransferTripType {
  ONE_WAY
  RETURN

  @@map("transfer_trip_type")
}

enum TransferLegDirection {
  OUTBOUND
  RETURN

  @@map("transfer_leg_direction")
}

/// How an add-on is priced. PERCENT is basis points of the leg fare; the rest
/// are minor units.
enum TransferExtraBasis {
  FIXED
  PER_PASSENGER
  PER_HOUR
  PERCENT

  @@map("transfer_extra_basis")
}

model TransferPoint {
  id   String            @id @default(cuid())
  slug String            @unique
  name String
  kind TransferPointKind @default(CITY)

  /// IATA code for airports, rendered as a chip in the picker.
  iataCode String? @map("iata_code") @db.Char(3)

  /// The second line of every option row: "Kakheti", "Adjara". Free text
  /// rather than a relation, because a point may sit in a region that has no
  /// destination page.
  regionLabel String @map("region_label")

  /// The join back to the marketing tree, when there is one. Optional because
  /// an airport terminal is not a destination.
  destinationId String?      @map("destination_id")
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  latitude  Float
  longitude Float

  /// Maintained by a trigger from latitude/longitude, exactly as on Destination
  /// and Hotel. Prisma can neither read nor write a PostGIS type; every
  /// geographic query is raw SQL.
  geo Unsupported("geography(Point, 4326)")?

  /// PlaceRef, as on Destination. Its place id is what stops the same airport
  /// being registered twice under two slugs.
  place Json?

  /// IANA. A pick-up time is a wall clock reading at the pick-up point, and
  /// this is what turns it into an instant — which is what a cancellation
  /// deadline and a driver roster both need.
  timezone String @default("Asia/Tbilisi")

  /// Surfaced before the traveller types anything.
  popular Boolean @default(false)
  image   String?

  status TransferStatus @default(ACTIVE)

  routesFrom   TransferRoute[]            @relation("TransferRouteFrom")
  routesTo     TransferRoute[]            @relation("TransferRouteTo")
  routeStops   TransferRouteStop[]
  legsFrom     TransferBookingLeg[]       @relation("TransferLegFrom")
  legsTo       TransferBookingLeg[]       @relation("TransferLegTo")
  translations TransferPointTranslation[]
  driversBased TransferDriver[]           @relation("DriverHomeBase")
  tourMeetings Tour[]                     @relation("TourMeetingPoint")

  packageFrom PackageComponent[] @relation("PackageComponentFrom")
  packageTo   PackageComponent[] @relation("PackageComponentTo")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([kind, status])
  @@index([destinationId])
  @@index([popular])
  @@map("transfer_points")
}

/// The company behind a vehicle class. Admin-managed today; partnerId is the
/// seam for opening a supplier extranet later, which is why it exists before
/// anything writes it.
model TransferProvider {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// Out of 5.
  rating      Float @default(0)
  reviewCount Int   @default(0) @map("review_count")

  /// Identity and licence checked by our team.
  verified    Boolean @default(false)
  yearsActive Int     @default(0) @map("years_active")

  partnerId String?  @map("partner_id")
  partner   Partner? @relation("PartnerTransferProviders", fields: [partnerId], references: [id], onDelete: SetNull)

  status TransferStatus @default(ACTIVE)

  vehicles      TransferVehicle[]
  fleetVehicles TransferFleetVehicle[]
  drivers       TransferDriver[]

  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  /// When and how this supplier is paid, and what it is owed after a cancellation.
  paymentTerms SupplierPaymentTerms?

  @@index([partnerId])
  @@index([status])
  @@map("transfer_providers")
}

/// A sellable vehicle class — the unit a traveller actually chooses.
///
/// Not one row per car. The supplier promises a category ("Toyota Camry or
/// similar"), and promising a specific registration is a promise that breaks
/// the first time it goes in for a service.
model TransferVehicle {
  id   String @id @default(cuid())
  slug String @unique
  name String

  vehicleClass TransferVehicleClass @map("vehicle_class")
  body         TransferVehicleBody
  kind         TransferKind         @default(PRIVATE)

  providerId String           @map("provider_id")
  provider   TransferProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  /// Capacity is a hard constraint on search, not a filter: showing a
  /// three-seat saloon to a party of six is not a choice, it is a mistake the
  /// traveller discovers at the kerb.
  maxPassengers Int @map("max_passengers")
  maxLuggage    Int @map("max_luggage")
  maxCabinBags  Int @default(0) @map("max_cabin_bags")

  /// Closed vocabulary matching the client TransferFeature union, so every
  /// surface renders the same icon and wording. Labels live in the dictionary,
  /// never here.
  features String[]

  vehicleExample String @map("vehicle_example")

  summary         String
  description     String[]
  included        String[]
  excluded        String[]
  pickupProcedure String   @map("pickup_procedure")

  /// A platform-level policy (CancellationPolicy.hotelId is null). Transfers
  /// use FLEXIBLE and PERCENT_OF_TOTAL tiers only; the night-based bases in
  /// ChargeBasis have no meaning for a journey.
  cancellationPolicyId String?             @map("cancellation_policy_id")
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: SetNull)

  /// The fallback fare model, used for any pair of points with no curated
  /// price: max(minimumFare, distanceKm x perKm) + airportFee. Minor units.
  perKmCents       Int    @map("per_km_cents")
  minimumFareCents Int    @map("minimum_fare_cents")
  airportFeeCents  Int    @default(0) @map("airport_fee_cents")
  currency         String @default("GEL") @db.Char(3)

  /// Multiplies the baseline road time. A bus is slower than a sedan over the
  /// same mountain road, and travellers notice when that is ignored.
  paceFactor Float @default(1) @map("pace_factor")

  /// Editorial ordering for the "Recommended" sort. Lower sorts first.
  recommendedRank Int @default(0) @map("recommended_rank")

  /// Whether this class is sold to the public at all. Everything is B2B by
  /// default, exactly as Hotel.b2cEnabled works.
  b2cEnabled Boolean @default(false) @map("b2c_enabled")

  status TransferStatus @default(DRAFT)

  partnerId String?  @map("partner_id")
  partner   Partner? @relation("PartnerTransferVehicles", fields: [partnerId], references: [id], onDelete: SetNull)

  prices        TransferRoutePrice[]
  blackouts     TransferBlackout[]
  bookings      TransferBooking[]
  translations  TransferVehicleTranslation[]
  /// The physical cars sold as this class.
  fleetVehicles TransferFleetVehicle[]       @relation("FleetVehicleClass")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, b2cEnabled])
  @@index([vehicleClass])
  @@index([providerId])
  @@index([partnerId])
  @@map("transfer_vehicles")
}

/// A named journey from the operator catalogue: TBS to Gudauri, Batumi to
/// Mestia, and roughly three hundred more.
///
/// A route is not required to sell a transfer — the distance engine will price
/// any pair of points. What a route adds is everything a pair cannot carry: a
/// curated price per class, a sales tier, an indexable URL, editorial copy, and
/// intermediate stops.
model TransferRoute {
  id   String @id @default(cuid())
  slug String @unique

  fromPointId String        @map("from_point_id")
  fromPoint   TransferPoint @relation("TransferRouteFrom", fields: [fromPointId], references: [id], onDelete: Restrict)
  toPointId   String        @map("to_point_id")
  toPoint     TransferPoint @relation("TransferRouteTo", fields: [toPointId], references: [id], onDelete: Restrict)

  tier     TransferRouteTier     @default(TIER_3)
  category TransferRouteCategory @default(CITY)

  /// Cached from the point coordinates at seed time and overridable by an
  /// admin who knows the road. Quoting reads these rather than recomputing, so
  /// a corrected figure sticks.
  distanceKm      Int @map("distance_km")
  durationMinutes Int @map("duration_minutes")

  /// Editorial, for the route landing page.
  title       String?
  summary     String?
  description String[]
  heroImage   String?  @map("hero_image")

  featured Boolean        @default(false)
  status   TransferStatus @default(DRAFT)

  stops        TransferRouteStop[]
  prices       TransferRoutePrice[]
  blackouts    TransferBlackout[]
  bookings     TransferBooking[]
  translations TransferRouteTranslation[]

  packageComponents PackageComponent[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  /// The reverse leg is its own route, because it is priced, described and sold
  /// separately — an airport arrival is not an airport departure.
  ///
  /// Not unique on the pair, and that is load-bearing: a direct Tbilisi to
  /// Telavi transfer and a Kakheti day trip that ends in Telavi share both
  /// endpoints and are different products. What is unique is one *direct* route
  /// per pair, enforced by a partial index in the migration, because Prisma
  /// cannot express a WHERE clause on one.
  @@index([fromPointId, toPointId])
  @@index([tier, status])
  @@index([category, status])
  @@index([featured])
  @@map("transfer_routes")
}

/// An intermediate stop on a multi-stop route: Ananuri on the way to Gudauri,
/// or a whole Grand Tour itinerary. A plain A-to-B route has none.
model TransferRouteStop {
  id      String        @id @default(cuid())
  routeId String        @map("route_id")
  route   TransferRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  pointId String        @map("point_id")
  point   TransferPoint @relation(fields: [pointId], references: [id], onDelete: Restrict)

  position     Int
  /// How long the car waits there, in minutes. Zero for a drive-past.
  dwellMinutes Int @default(0) @map("dwell_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([routeId, position])
  @@index([pointId])
  @@map("transfer_route_stops")
}

/// What one vehicle class costs on one route. Absence is meaningful: it means
/// the distance engine prices that combination.
model TransferRoutePrice {
  id String @id @default(cuid())

  routeId String        @map("route_id")
  route   TransferRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  vehicleId String          @map("vehicle_id")
  vehicle   TransferVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Minor units. returnCents is null when a return is simply twice the
  /// one-way; setting it is how a discounted round trip is expressed.
  oneWayCents Int  @map("one_way_cents")
  returnCents Int? @map("return_cents")

  /// What the supplier charges us. Never serialised to a guest. Null means
  /// derive the margin from the markup rules instead.
  netCents Int? @map("net_cents")

  currency String  @default("GEL") @db.Char(3)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([routeId, vehicleId])
  @@index([vehicleId])
  @@map("transfer_route_prices")
}

/// The add-ons offered on every route: a child seat, ski carriage, meet and
/// greet, an extra sightseeing stop.
model TransferExtra {
  id   String @id @default(cuid())
  code String @unique
  name String

  description String?

  basis      TransferExtraBasis @default(FIXED)
  /// Minor units, except for PERCENT where it is basis points.
  priceCents Int                @map("price_cents")
  currency   String             @default("GEL") @db.Char(3)

  /// Empty means every class. A ski rack on a sedan is not a product.
  appliesToClasses TransferVehicleClass[] @map("applies_to_classes")

  /// Sort order in the checkout list.
  position Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, position])
  @@map("transfer_extras")
}

/// A window in which a route or a vehicle cannot be sold.
///
/// This is the real constraint that replaces inventory. Georgian mountain roads
/// close: Tusheti from October, Shatili in winter, the Goderdzi pass in snow.
/// Selling a January transfer to Omalo is a promise nobody can keep.
model TransferBlackout {
  id String @id @default(cuid())

  /// At least one of the two is set, enforced by a CHECK constraint in the
  /// migration. A route-only row closes a road; a vehicle-only row takes a
  /// class off the market.
  routeId String?        @map("route_id")
  route   TransferRoute? @relation(fields: [routeId], references: [id], onDelete: Cascade)

  vehicleId String?          @map("vehicle_id")
  vehicle   TransferVehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Inclusive both ends: a road is shut on the last day too.
  from   DateTime @db.Date
  to     DateTime @db.Date
  reason String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([routeId, from, to])
  @@index([vehicleId, from, to])
  @@map("transfer_blackouts")
}

model TransferBooking {
  id String @id @default(cuid())

  /// The public reference, e.g. TRF-000001, from a Postgres sequence. Never the
  /// primary key: an id is an implementation detail that must not appear in
  /// something a traveller reads out to a driver.
  reference String @unique

  status TransferBookingStatus @default(PENDING)

  /// What makes a retried confirmation return the original booking rather than
  /// dispatching a second car.
  idempotencyKey String? @unique @map("idempotency_key")

  partnerId      String?  @map("partner_id")
  partner        Partner? @relation("PartnerTransferBookings", fields: [partnerId], references: [id], onDelete: SetNull)
  bookedByUserId String?  @map("booked_by_user_id")
  bookedByUser   User?    @relation("TransferBookingBookedBy", fields: [bookedByUserId], references: [id], onDelete: SetNull)

  /// Kept for reporting. The snapshots are what the voucher reads.
  routeId String?        @map("route_id")
  route   TransferRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  vehicleId String          @map("vehicle_id")
  vehicle   TransferVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  tripType TransferTripType @default(ONE_WAY) @map("trip_type")

  /// Absolute instants, resolved from the wall-clock pick-up time in the
  /// pick-up point timezone. Stored as instants and not as a date plus a
  /// string, because a driver roster and a cancellation deadline both need to
  /// order them against real time.
  pickupAt       DateTime  @map("pickup_at")
  returnPickupAt DateTime? @map("return_pickup_at")

  adults    Int
  children  Int   @default(0)
  childAges Int[] @map("child_ages")
  luggage   Int   @default(0)
  cabinBags Int   @default(0) @map("cabin_bags")

  currency       String @db.Char(3)
  netTotalCents  Int    @map("net_total_cents")
  sellTotalCents Int    @map("sell_total_cents")
  markupBps      Int    @map("markup_bps")
  /// The agency's own commission rate when it booked, beside the markup actually applied (a pricing rule may have won).
  commissionRateBps Int? @map("commission_rate_bps")

  leadPassengerName  String  @map("lead_passenger_name")
  leadPassengerEmail String  @map("lead_passenger_email")
  leadPassengerPhone String? @map("lead_passenger_phone")

  /// Airport pick-ups are monitored against the flight, so a delayed arrival
  /// moves the car rather than losing the fare.
  flightNumber String? @map("flight_number")

  /// Free text, because a door is not a coordinate: "Hotel Vera, reception" is
  /// what the driver needs and what the traveller can supply.
  pickupAddress   String? @map("pickup_address")
  dropoffAddress  String? @map("dropoff_address")
  /// The same doors as a searched place — coordinates plus a PlaceRef — when
  /// the traveller picked one. What a driver navigates to; the text above is
  /// what they read. Null for bookings made before place search existed.
  pickupPlace     Json?   @map("pickup_place")
  dropoffPlace    Json?   @map("dropoff_place")
  specialRequests String? @map("special_requests")

  /// The journey and the vehicle as they were sold. A voucher printed next
  /// year must still describe what was booked, even if the route has since
  /// been renamed or the class retired.
  routeSnapshot   Json @map("route_snapshot")
  vehicleSnapshot Json @map("vehicle_snapshot")

  /// The policy tiers resolved to absolute instants at the moment of
  /// confirmation. Cancelling is a lookup here, never a read of the current
  /// policy, so terms tightened in March cannot change what a January traveller
  /// is owed.
  cancellationSchedule Json @map("cancellation_schedule")

  confirmedAt             DateTime? @map("confirmed_at")
  cancelledAt             DateTime? @map("cancelled_at")
  cancellationChargeCents Int?      @map("cancellation_charge_cents")
  cancellationReason      String?   @map("cancellation_reason")
  /// Set by the roll-up when the last leg reaches a terminal state.
  completedAt             DateTime? @map("completed_at")

  /// Where it came from: web, partner API, admin.
  source String @default("web")

  legs        TransferBookingLeg[]
  extras      TransferBookingExtra[]
  assignments TransferAssignment[]
  ratings     TransferDriverRating[]

  orderItem  OrderItem?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  /// Finance: what we owe the supplier, and what the buyer owes us (standalone bookings only).
  payable    SupplierPayable?
  receivable Receivable?

  @@index([vehicleId, pickupAt])
  @@index([routeId, pickupAt])
  @@index([partnerId, createdAt])
  @@index([status, pickupAt])
  @@map("transfer_bookings")
}

/// One journey, as it was sold. A return is two legs.
///
/// The same reasoning as HotelBookingRoom: a single total cannot support
/// cancelling one direction, invoicing a line, or telling a driver what their
/// half of the job is worth.
model TransferBookingLeg {
  id        String          @id @default(cuid())
  bookingId String          @map("booking_id")
  booking   TransferBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  legIndex  Int                  @map("leg_index")
  direction TransferLegDirection @default(OUTBOUND)

  /// SetNull, not Restrict: these are for reporting, and the booking has to
  /// survive a point being retired. The names beside them are the record.
  fromPointId String?        @map("from_point_id")
  fromPoint   TransferPoint? @relation("TransferLegFrom", fields: [fromPointId], references: [id], onDelete: SetNull)
  toPointId   String?        @map("to_point_id")
  toPoint     TransferPoint? @relation("TransferLegTo", fields: [toPointId], references: [id], onDelete: SetNull)

  fromPointName String @map("from_point_name")
  toPointName   String @map("to_point_name")

  pickupAt        DateTime @map("pickup_at")
  distanceKm      Int      @map("distance_km")
  durationMinutes Int      @map("duration_minutes")

  netCents  Int @map("net_cents")
  sellCents Int @map("sell_cents")

  /// Operational state — who is doing this leg and how far along it is. The
  /// commercial state stays on the booking. Live states have exactly one
  /// OFFERED/ACCEPTED assignment; the partial unique index in the migration
  /// makes that a database fact.
  status          TransferLegStatus @default(UNASSIGNED)
  statusChangedAt DateTime          @default(now()) @map("status_changed_at")

  /// Idempotency stamps for the reminder sweeper: set in the same statement
  /// that enqueues the event, so a crash between the two cannot double-send.
  reminderSentAt      DateTime? @map("reminder_sent_at")
  driverDetailsSentAt DateTime? @map("driver_details_sent_at")
  unassignedAlertAt   DateTime? @map("unassigned_alert_at")

  assignments TransferAssignment[]
  rating      TransferDriverRating?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([bookingId, legIndex])
  @@index([fromPointId])
  @@index([toPointId])
  @@index([status, pickupAt])
  @@map("transfer_booking_legs")
}

/// An add-on as it was priced, frozen. The catalogue may reprice a child seat
/// tomorrow; this booking bought one at the figure quoted today.
model TransferBookingExtra {
  id        String          @id @default(cuid())
  bookingId String          @map("booking_id")
  booking   TransferBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  code     String
  name     String
  quantity Int    @default(1)

  unitCents  Int @map("unit_cents")
  totalCents Int @map("total_cents")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([bookingId, code])
  @@map("transfer_booking_extras")
}

model TransferPointTranslation {
  id      String        @id @default(cuid())
  pointId String        @map("point_id")
  point   TransferPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  locale String @db.VarChar(5)

  name        String?
  regionLabel String? @map("region_label")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([pointId, locale])
  @@map("transfer_point_translations")
}

model TransferVehicleTranslation {
  id        String          @id @default(cuid())
  vehicleId String          @map("vehicle_id")
  vehicle   TransferVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  locale String @db.VarChar(5)

  name            String?
  vehicleExample  String?  @map("vehicle_example")
  summary         String?
  description     String[]
  included        String[]
  excluded        String[]
  pickupProcedure String?  @map("pickup_procedure")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([vehicleId, locale])
  @@map("transfer_vehicle_translations")
}

model TransferRouteTranslation {
  id      String        @id @default(cuid())
  routeId String        @map("route_id")
  route   TransferRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  locale String @db.VarChar(5)

  title       String?
  summary     String?
  description String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([routeId, locale])
  @@map("transfer_route_translations")
}

// ---------------------------------------------------------------------------
// Transfer operations: fleet, drivers, dispatch, ratings
//
// The catalogue above sells a *class* of car. This block is what actually
// turns up at the kerb: an individual car, a named driver, and the record of
// which of them was sent to which leg of which booking.
//
// The commercial state of a booking (`TransferBooking.status`) is untouched.
// Operational progress lives on the leg, because a return booking is two jobs
// on two days with, quite possibly, two drivers. An assignment is one offer of
// one driver for one leg; reassignment never edits the old row, it revokes it
// and inserts a new one, so the history of who was asked is always there.
//
// Double-booking is prevented in the database, not just in the service: an
// EXCLUDE constraint over (driver, time window) and another over (car, time
// window), both added in the migration because Prisma cannot express them.
// ---------------------------------------------------------------------------

enum TransferDriverVerification {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED

  @@map("transfer_driver_verification")
}

/// Operational state of one leg. UNASSIGNED..ON_BOARD are live; COMPLETED,
/// NO_SHOW and CANCELLED are terminal. NO_SHOW_REPORTED is the driver's claim
/// awaiting an operations decision.
enum TransferLegStatus {
  UNASSIGNED
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  ON_BOARD
  COMPLETED
  NO_SHOW_REPORTED
  NO_SHOW
  CANCELLED

  @@map("transfer_leg_status")
}

/// Lifecycle of one offer. OFFERED and ACCEPTED are the only two that occupy
/// the driver's and the car's time; everything else has dropped out of the
/// exclusion constraint.
enum TransferAssignmentStatus {
  OFFERED
  ACCEPTED
  DECLINED
  REVOKED
  COMPLETED
  NO_SHOW

  @@map("transfer_assignment_status")
}

enum TransferRatingStatus {
  PENDING
  PUBLISHED
  REJECTED

  @@map("transfer_rating_status")
}

enum TransferRatingSource {
  GUEST
  PARTNER
  ADMIN

  @@map("transfer_rating_source")
}

enum NotificationKind {
  TRANSFER_ASSIGNMENT_OFFERED
  TRANSFER_ASSIGNMENT_ACCEPTED
  TRANSFER_ASSIGNMENT_DECLINED
  TRANSFER_ASSIGNMENT_REVOKED
  TRANSFER_LEG_UNASSIGNED_ALERT
  TRANSFER_LEG_STATUS_CHANGED
  TRANSFER_LEG_NO_SHOW_REPORTED
  TRANSFER_BOOKING_CANCELLED
  TRANSFER_PICKUP_REMINDER
  TRANSFER_DRIVER_DETAILS
  TRANSFER_RATING_RECEIVED
  TOUR_REQUEST_OVERDUE
  ORDER_REQUEST_OVERDUE
  PACKAGE_KOSHER_ELIGIBILITY_CHANGED
  FINANCE_PAYABLE_DUE
  FINANCE_PAYABLE_OVERDUE
  FINANCE_RECEIVABLE_OVERDUE
  FINANCE_PAYMENT_RECEIVED
  FINANCE_INVOICE_ISSUED
  FINANCE_INVOICE_SYNC_FAILED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  FINANCE_CREDIT_WARNING

  @@map("notification_kind")
}

/// A physical car. Owned by a provider, sold as one class.
///
/// The class link is what assignment validates against: a car sold as COMFORT
/// on an ECONOMY booking is an upgrade a dispatcher may choose, a car with
/// three seats on a party of five is a mistake at the kerb, so the capacity
/// check is hard and the class check is an audited override.
model TransferFleetVehicle {
  id String @id @default(cuid())

  providerId String           @map("provider_id")
  provider   TransferProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  vehicleClassId String          @map("vehicle_class_id")
  vehicleClass   TransferVehicle @relation("FleetVehicleClass", fields: [vehicleClassId], references: [id], onDelete: Restrict)

  make   String
  model  String
  year   Int?
  colour String?
  body   TransferVehicleBody

  /// As typed, for display. Matched on the normalised form below, which is
  /// unique among non-archived cars (partial index in the migration).
  plateNumber     String  @map("plate_number")
  plateNormalized String  @map("plate_normalized")
  /// Internal.
  vin             String?

  passengerCapacity Int @map("passenger_capacity")
  luggageCapacity   Int @map("luggage_capacity")
  cabinBagCapacity  Int @default(0) @map("cabin_bag_capacity")

  /// Closed vocabulary, validated on write: the class feature list plus
  /// `wheelchairAccessible`.
  features String[]

  /// Public copy.
  description   String?
  /// Never leaves the admin panel.
  internalNotes String? @map("internal_notes")

  mainImageId String?    @map("main_image_id")
  mainImage   FileAsset? @relation("FleetVehicleMainImage", fields: [mainImageId], references: [id], onDelete: SetNull)

  status TransferStatus @default(DRAFT)

  images      TransferFleetVehicleImage[]
  documents   TransferFleetVehicleDocument[]
  drivers     TransferDriverVehicle[]
  assignments TransferAssignment[]
  blocks      TransferResourceBlock[]
  ratings     TransferDriverRating[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([providerId, status])
  @@index([vehicleClassId])
  @@map("transfer_fleet_vehicles")
}

/// The gallery join for a car, shaped exactly like HotelImage so the same
/// gallery service drives both.
model TransferFleetVehicleImage {
  id             String               @id @default(cuid())
  fleetVehicleId String               @map("fleet_vehicle_id")
  fleetVehicle   TransferFleetVehicle @relation(fields: [fleetVehicleId], references: [id], onDelete: Cascade)
  fileAssetId    String               @map("file_asset_id")
  fileAsset      FileAsset            @relation("FleetVehicleImages", fields: [fileAssetId], references: [id], onDelete: Restrict)

  caption   String?
  sortOrder Int     @default(0) @map("sort_order")
  /// At most one per car: partial unique index in the migration.
  isCover   Boolean @default(false) @map("is_cover")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fleetVehicleId, fileAssetId])
  @@index([fleetVehicleId, sortOrder])
  @@map("transfer_fleet_vehicle_images")
}

/// Registration, insurance, inspection. Same rules as HotelDocument: the
/// asset is PRIVATE and the bytes are reached only through a signed request.
model TransferFleetVehicleDocument {
  id             String               @id @default(cuid())
  fleetVehicleId String               @map("fleet_vehicle_id")
  fleetVehicle   TransferFleetVehicle @relation(fields: [fleetVehicleId], references: [id], onDelete: Cascade)
  fileAssetId    String               @map("file_asset_id")
  fileAsset      FileAsset            @relation("FleetVehicleDocuments", fields: [fileAssetId], references: [id], onDelete: Restrict)

  /// REGISTRATION | INSURANCE | TECHNICAL_INSPECTION | OTHER
  docType    String    @map("doc_type")
  label      String?
  validUntil DateTime? @map("valid_until") @db.Date

  uploadedByUserId String? @map("uploaded_by_user_id")
  uploadedByUser   User?   @relation("FleetVehicleDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fleetVehicleId, fileAssetId])
  @@index([fleetVehicleId, docType])
  @@map("transfer_fleet_vehicle_documents")
}

/// A driver. The profile, not the login: a profile can exist before an
/// account is linked (a subcontractor's driver the dispatcher phones) and
/// survives the account being deactivated.
///
/// Affiliation is the provider, never `User.partnerId`. A DRIVER user carries
/// no partnerId at all, which is what keeps every partner-scoped query on the
/// platform closed to drivers without each of them having to remember.
model TransferDriver {
  id String @id @default(cuid())

  userId String? @unique @map("user_id")
  user   User?   @relation("DriverUser", fields: [userId], references: [id], onDelete: SetNull)

  providerId String           @map("provider_id")
  provider   TransferProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  /// Required: dispatch is a phone call when the app is not answering.
  phone     String
  /// Contact only. The login email lives on the User.
  email     String?

  /// ISO 639-1 codes.
  languages       String[]
  yearsExperience Int      @default(0) @map("years_experience")
  /// Public.
  bio             String?

  photoFileAssetId String?    @map("photo_file_asset_id")
  photo            FileAsset? @relation("DriverPhoto", fields: [photoFileAssetId], references: [id], onDelete: SetNull)

  // --- internal, never serialised outside operations ---
  licenceNumber    String?   @map("licence_number")
  licenceExpiresOn DateTime? @map("licence_expires_on") @db.Date
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  internalNotes    String?   @map("internal_notes")

  verificationStatus TransferDriverVerification @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?                  @map("verified_at")
  verifiedByUserId   String?                    @map("verified_by_user_id")
  verifiedByUser     User?                      @relation("DriverVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  isActive           Boolean   @default(true) @map("is_active")
  deactivatedAt      DateTime? @map("deactivated_at")
  deactivationReason String?   @map("deactivation_reason")

  /// Where the driver starts the day. The seam for automatic assignment.
  homeBasePointId String?        @map("home_base_point_id")
  homeBasePoint   TransferPoint? @relation("DriverHomeBase", fields: [homeBasePointId], references: [id], onDelete: SetNull)

  /// Denormalised and recomputed from the rating rows in the same transaction
  /// as whatever changed them — never incremented, never edited by hand.
  ratingAvg      Float @default(0) @map("rating_avg")
  ratingCount    Int   @default(0) @map("rating_count")
  completedCount Int   @default(0) @map("completed_count")

  vehicles    TransferDriverVehicle[]
  documents   TransferDriverDocument[]
  assignments TransferAssignment[]
  blocks      TransferResourceBlock[]
  ratings     TransferDriverRating[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([providerId, isActive])
  @@index([verificationStatus])
  @@map("transfer_drivers")
}

model TransferDriverDocument {
  id          String         @id @default(cuid())
  driverId    String         @map("driver_id")
  driver      TransferDriver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  fileAssetId String         @map("file_asset_id")
  fileAsset   FileAsset      @relation("DriverDocuments", fields: [fileAssetId], references: [id], onDelete: Restrict)

  /// DRIVING_LICENCE | ID_DOCUMENT | MEDICAL | BACKGROUND_CHECK | OTHER
  docType    String    @map("doc_type")
  label      String?
  validUntil DateTime? @map("valid_until") @db.Date

  uploadedByUserId String? @map("uploaded_by_user_id")
  uploadedByUser   User?   @relation("DriverDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([driverId, fileAssetId])
  @@index([driverId, docType])
  @@map("transfer_driver_documents")
}

/// Which cars a driver usually takes. Eligibility and a default for the
/// dispatch screen, not the record of what was driven — that is on the
/// assignment. At most one primary per driver (partial index in the migration).
model TransferDriverVehicle {
  id             String               @id @default(cuid())
  driverId       String               @map("driver_id")
  driver         TransferDriver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  fleetVehicleId String               @map("fleet_vehicle_id")
  fleetVehicle   TransferFleetVehicle @relation(fields: [fleetVehicleId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([driverId, fleetVehicleId])
  @@index([fleetVehicleId])
  @@map("transfer_driver_vehicles")
}

/// One offer of one driver, and usually one car, for one leg.
///
/// Append-only. The leg's status says where the job is; this row says who was
/// sent, when they said yes, and — through the milestone stamps — how far
/// they got, which a superseded row still remembers after a reassignment.
///
/// `windowStart`/`windowEnd` are the occupancy the exclusion constraints
/// protect: pick-up minus a buffer to the end of the journey plus a buffer.
/// The buffers are stored on the row so a later change of config cannot
/// reinterpret history.
model TransferAssignment {
  id String @id @default(cuid())

  legId String             @map("leg_id")
  leg   TransferBookingLeg @relation(fields: [legId], references: [id], onDelete: Cascade)

  /// Denormalised from the leg for the driver's list queries and the partner
  /// scope join.
  bookingId String          @map("booking_id")
  booking   TransferBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  driverId       String                @map("driver_id")
  driver         TransferDriver        @relation(fields: [driverId], references: [id], onDelete: Restrict)
  fleetVehicleId String?               @map("fleet_vehicle_id")
  fleetVehicle   TransferFleetVehicle? @relation(fields: [fleetVehicleId], references: [id], onDelete: Restrict)

  status TransferAssignmentStatus @default(OFFERED)

  windowStart       DateTime @map("window_start")
  windowEnd         DateTime @map("window_end")
  preBufferMinutes  Int      @map("pre_buffer_minutes")
  postBufferMinutes Int      @map("post_buffer_minutes")

  assignedByUserId String?  @map("assigned_by_user_id")
  assignedByUser   User?    @relation("AssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  assignedAt       DateTime @default(now()) @map("assigned_at")
  /// What the dispatcher knowingly overrode: CLASS_MISMATCH, VEHICLE_NOT_LINKED,
  /// UNVERIFIED_DRIVER. Empty for a clean assignment.
  overrides        String[]

  acceptedAt    DateTime? @map("accepted_at")
  declinedAt    DateTime? @map("declined_at")
  declineReason String?   @map("decline_reason")
  revokedAt     DateTime? @map("revoked_at")
  revokeReason  String?   @map("revoke_reason")

  supersededByAssignmentId String?             @unique @map("superseded_by_assignment_id")
  supersededBy             TransferAssignment? @relation("AssignmentSupersedes", fields: [supersededByAssignmentId], references: [id], onDelete: SetNull)
  supersedes               TransferAssignment? @relation("AssignmentSupersedes")

  /// Milestones, always the server clock. A phone's clock is not evidence.
  enRouteAt        DateTime? @map("en_route_at")
  arrivedAt        DateTime? @map("arrived_at")
  pickedUpAt       DateTime? @map("picked_up_at")
  completedAt      DateTime? @map("completed_at")
  noShowReportedAt DateTime? @map("no_show_reported_at")

  driverNotes     String? @map("driver_notes")
  dispatcherNotes String? @map("dispatcher_notes")

  ratings TransferDriverRating[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([driverId, windowStart])
  @@index([fleetVehicleId, windowStart])
  @@index([legId, status])
  @@index([bookingId])
  @@index([status, windowStart])
  @@map("transfer_assignments")
}

/// A driver's day off or a car's service slot. Exactly one of the two targets
/// is set (CHECK in the migration). Checked against assignments under the
/// same row lock the dispatcher takes, so a block is never placed over a job.
model TransferResourceBlock {
  id String @id @default(cuid())

  driverId       String?               @map("driver_id")
  driver         TransferDriver?       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  fleetVehicleId String?               @map("fleet_vehicle_id")
  fleetVehicle   TransferFleetVehicle? @relation(fields: [fleetVehicleId], references: [id], onDelete: Cascade)

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  /// DAY_OFF | SICK | MAINTENANCE | OTHER
  reason String
  note   String?

  createdByUserId String? @map("created_by_user_id")
  createdByUser   User?   @relation("ResourceBlockCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([driverId, startsAt])
  @@index([fleetVehicleId, startsAt])
  @@map("transfer_resource_blocks")
}

/// One rating for one completed leg. The unique leg is what makes a second
/// submission a conflict rather than a second opinion. The assignment is
/// snapshotted so a later correction of who drove cannot move the score.
model TransferDriverRating {
  id String @id @default(cuid())

  legId     String             @unique @map("leg_id")
  leg       TransferBookingLeg @relation(fields: [legId], references: [id], onDelete: Cascade)
  bookingId String             @map("booking_id")
  booking   TransferBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  driverId       String                @map("driver_id")
  driver         TransferDriver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  assignmentId   String                @map("assignment_id")
  assignment     TransferAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fleetVehicleId String?               @map("fleet_vehicle_id")
  fleetVehicle   TransferFleetVehicle? @relation(fields: [fleetVehicleId], references: [id], onDelete: SetNull)

  /// 1..5, CHECK in the migration.
  score   Int
  comment String?

  source            TransferRatingSource
  submittedByUserId String?              @map("submitted_by_user_id")
  submittedByUser   User?                @relation("RatingSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  /// Lower-cased lead passenger email for GUEST submissions.
  submittedByEmail  String?              @map("submitted_by_email")

  status            TransferRatingStatus @default(PENDING)
  moderatedAt       DateTime?            @map("moderated_at")
  moderatedByUserId String?              @map("moderated_by_user_id")
  moderatedByUser   User?                @relation("RatingModeratedBy", fields: [moderatedByUserId], references: [id], onDelete: SetNull)
  moderationNote    String?              @map("moderation_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([driverId, status])
  @@index([status, createdAt])
  @@map("transfer_driver_ratings")
}

/// An in-app notification. Written by the outbox drain, never directly by a
/// request handler, so every channel sees the same event once.
model Notification {
  id String @id @default(cuid())

  recipientUserId String @map("recipient_user_id")
  recipientUser   User   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  kind  NotificationKind
  title String
  body  String

  /// Deep-link data: booking reference, leg, assignment, driver.
  payload Json @default("{}")

  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([recipientUserId, readAt, createdAt])
  @@map("notifications")
}

/// The transactional outbox. Written in the same transaction as the state
/// change it describes and drained by a sweeper, which is what lets an email
/// be retried without the booking being re-cancelled. This — not the audit
/// log — is the queue: audit rows are history and never carry processing
/// state.
model OutboxEvent {
  id String @id @default(cuid())

  /// e.g. transfer.assignment.offered
  topic   String
  payload Json

  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  processedAt   DateTime? @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([processedAt, nextAttemptAt])
  @@map("outbox_events")
}

// --- Finance --------------------------------------------------------------------
//
// Operational finance, not bookkeeping: who owes whom how much, since when, and
// what has been paid. Every row hangs off a booking or an order by a nullable
// unique foreign key (the OrderItem exactly-one-child pattern), so the booking
// tables themselves carry no finance columns. Amounts are integer minor units in
// the row's own currency; nothing here ever adds two currencies together.

enum FinanceProduct {
  HOTEL
  TRANSFER
  TOUR
  SERVICE

  @@map("finance_product")
}

enum SettlementStatus {
  OPEN
  PARTIAL
  PAID
  /// Nothing is owed any more and nothing was paid: a cancellation that left
  /// no charge, or an instalment the cancellation made unnecessary.
  VOID
  /// Finance decided not to collect or pay what remained, with a reason.
  WAIVED

  @@map("settlement_status")
}

enum InstalmentKind {
  DEPOSIT
  BALANCE

  @@map("instalment_kind")
}

/// What a supplier is owed when a booking is cancelled with a charge (D6).
enum CancellationLiability {
  /// The same share of the net as the share of the price that was charged:
  /// 50% charged to the buyer → 50% of the net owed to the supplier.
  PROPORTIONAL
  /// Nothing, unless the booking was charged in full (non-refundable), in
  /// which case the whole net.
  NONE_UNLESS_NON_REFUNDABLE
  /// Finance decides each case: the payable stops at what was already paid
  /// and is flagged for review.
  MANUAL

  @@map("cancellation_liability")
}

enum ReceivableDueAnchor {
  CONFIRMATION
  ARRIVAL

  @@map("receivable_due_anchor")
}

enum PaymentDirection {
  /// Money in: an agency or a guest paying us.
  IN
  /// Money out: us paying a supplier.
  OUT

  @@map("payment_direction")
}

enum PaymentKind {
  PAYMENT
  REFUND

  @@map("payment_kind")
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  OTHER

  @@map("payment_method")
}

/// One row per Hotel, TransferProvider, Tour or Service (exactly one, CHECK).
/// No row means no terms: a single BALANCE instalment with no due date, and
/// PROPORTIONAL on cancellation.
model SupplierPaymentTerms {
  id                 String            @id @default(cuid())
  hotelId            String?           @unique @map("hotel_id")
  hotel              Hotel?            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  transferProviderId String?           @unique @map("transfer_provider_id")
  transferProvider   TransferProvider? @relation(fields: [transferProviderId], references: [id], onDelete: Cascade)
  tourId             String?           @unique @map("tour_id")
  tour               Tour?             @relation(fields: [tourId], references: [id], onDelete: Cascade)
  serviceId          String?           @unique @map("service_id")
  service            Service?          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// [{ kind: DEPOSIT|BALANCE, basis: PERCENT|FIXED, value: Int (bps or minor
  /// units), anchor: CONFIRMATION|ARRIVAL|DEPARTURE, offsetDays: Int }].
  /// Validated by `jsonFieldSchemas` (validation/domain.js).
  milestones            Json                  @default("[]")
  cancellationLiability CancellationLiability @default(PROPORTIONAL) @map("cancellation_liability")
  /// Local clock time ("HH:MM") instalments fall due at, in the supplier's timezone.
  cutoffTime            String?               @map("cutoff_time")
  notes                 String?
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@map("supplier_payment_terms")
}

/// What we owe a supplier for one booking.
model SupplierPayable {
  id                String           @id @default(cuid())
  product           FinanceProduct
  hotelBookingId    String?          @unique @map("hotel_booking_id")
  hotelBooking      HotelBooking?    @relation(fields: [hotelBookingId], references: [id], onDelete: Restrict)
  transferBookingId String?          @unique @map("transfer_booking_id")
  transferBooking   TransferBooking? @relation(fields: [transferBookingId], references: [id], onDelete: Restrict)
  tourBookingId     String?          @unique @map("tour_booking_id")
  tourBooking       TourBooking?     @relation(fields: [tourBookingId], references: [id], onDelete: Restrict)
  serviceBookingId  String?          @unique @map("service_booking_id")
  serviceBooking    ServiceBooking?  @relation(fields: [serviceBookingId], references: [id], onDelete: Restrict)

  /// Null for platform-owned inventory: still a cost, listed under "Platform".
  supplierPartnerId String?  @map("supplier_partner_id")
  supplierPartner   Partner? @relation("PartnerSupplierPayables", fields: [supplierPartnerId], references: [id], onDelete: Restrict)

  bookingReference      String                 @map("booking_reference")
  timezone              String
  currency              String                 @db.Char(3)
  /// The net at confirmation. Never changes.
  originalAmountCents   Int                    @map("original_amount_cents")
  /// What is owed now: the original, or less after a cancellation.
  amountCents           Int                    @map("amount_cents")
  /// Finance's own figure, which every later recomputation respects.
  amountOverrideCents   Int?                   @map("amount_override_cents")
  overrideReason        String?                @map("override_reason")
  paidCents             Int                    @default(0) @map("paid_cents")
  status                SettlementStatus       @default(OPEN)
  nextDueAt             DateTime?              @map("next_due_at")
  /// Raised when the amount needs a person: a MANUAL cancellation, a supplier
  /// with no terms. Cleared when Finance sets the amount.
  needsReview           Boolean                @default(false) @map("needs_review")
  reviewReason          String?                @map("review_reason")
  cancellationLiability CancellationLiability? @map("cancellation_liability")
  voidedAt              DateTime?              @map("voided_at")
  waivedAt              DateTime?              @map("waived_at")
  /// CONFIRM, BACKFILL or MANUAL.
  source                String                 @default("CONFIRM")
  notes                 String?
  instalments           PayableInstalment[]
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@index([status, nextDueAt])
  @@index([supplierPartnerId, status, createdAt])
  @@index([product, createdAt])
  @@index([currency, status])
  @@map("supplier_payables")
}

model PayableInstalment {
  id                  String              @id @default(cuid())
  payableId           String              @map("payable_id")
  payable             SupplierPayable     @relation(fields: [payableId], references: [id], onDelete: Cascade)
  sequence            Int
  kind                InstalmentKind
  /// As scheduled at confirmation. Never changes.
  originalAmountCents Int                 @map("original_amount_cents")
  amountCents         Int                 @map("amount_cents")
  paidCents           Int                 @default(0) @map("paid_cents")
  dueAt               DateTime?           @map("due_at")
  status              SettlementStatus    @default(OPEN)
  overdueAlertAt      DateTime?           @map("overdue_alert_at")
  voidedAt            DateTime?           @map("voided_at")
  reminders           PayableReminder[]
  allocations         PaymentAllocation[]
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@unique([payableId, sequence])
  @@index([status, dueAt])
  @@map("payable_instalments")
}

/// One row per (instalment, offset) reminded; the unique pair is what makes a
/// reminder fire once however many sweepers run.
model PayableReminder {
  id           String            @id @default(cuid())
  instalmentId String            @map("instalment_id")
  instalment   PayableInstalment @relation(fields: [instalmentId], references: [id], onDelete: Cascade)
  offsetDays   Int               @map("offset_days")
  sentAt       DateTime          @default(now()) @map("sent_at")

  @@unique([instalmentId, offsetDays])
  @@index([sentAt])
  @@map("payable_reminders")
}

/// What an agency or a guest owes us: one per standalone booking, or one per order.
model Receivable {
  id                String           @id @default(cuid())
  hotelBookingId    String?          @unique @map("hotel_booking_id")
  hotelBooking      HotelBooking?    @relation(fields: [hotelBookingId], references: [id], onDelete: Restrict)
  transferBookingId String?          @unique @map("transfer_booking_id")
  transferBooking   TransferBooking? @relation(fields: [transferBookingId], references: [id], onDelete: Restrict)
  tourBookingId     String?          @unique @map("tour_booking_id")
  tourBooking       TourBooking?     @relation(fields: [tourBookingId], references: [id], onDelete: Restrict)
  serviceBookingId  String?          @unique @map("service_booking_id")
  serviceBooking    ServiceBooking?  @relation(fields: [serviceBookingId], references: [id], onDelete: Restrict)
  orderId           String?          @unique @map("order_id")
  order             Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// The booking or order reference: what a payer quotes on a transfer.
  reference           String
  debtorPartnerId     String?             @map("debtor_partner_id")
  debtorPartner       Partner?            @relation("PartnerReceivables", fields: [debtorPartnerId], references: [id], onDelete: Restrict)
  debtorEmail         String              @map("debtor_email")
  debtorName          String              @map("debtor_name")
  currency            String              @db.Char(3)
  originalAmountCents Int                 @map("original_amount_cents")
  amountCents         Int                 @map("amount_cents")
  paidCents           Int                 @default(0) @map("paid_cents")
  status              SettlementStatus    @default(OPEN)
  /// Set at creation from the partner's terms; Finance may move it (D5).
  dueAt               DateTime?           @map("due_at")
  overdueAlertAt      DateTime?           @map("overdue_alert_at")
  voidedAt            DateTime?           @map("voided_at")
  waivedAt            DateTime?           @map("waived_at")
  source              String              @default("CONFIRM")
  notes               String?
  allocations         PaymentAllocation[]
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@index([status, dueAt])
  @@index([debtorPartnerId, status, createdAt])
  @@index([debtorEmail])
  @@index([currency, status])
  @@map("receivables")
}

/// Money that moved, in either direction. Refunds are rows with kind REFUND,
/// so a refund and a payment share one table and one idempotency path.
model PaymentRecord {
  id                    String              @id @default(cuid())
  direction             PaymentDirection
  kind                  PaymentKind         @default(PAYMENT)
  method                PaymentMethod
  counterpartyPartnerId String?             @map("counterparty_partner_id")
  counterpartyPartner   Partner?            @relation("PartnerPaymentRecords", fields: [counterpartyPartnerId], references: [id], onDelete: Restrict)
  counterpartyName      String?             @map("counterparty_name")
  counterpartyEmail     String?             @map("counterparty_email")
  currency              String              @db.Char(3)
  amountCents           Int                 @map("amount_cents")
  /// The bank's reference, a receipt number.
  reference             String?
  paidAt                DateTime            @map("paid_at")
  note                  String?
  /// Required for a refund.
  reason                String?
  recordedByUserId      String?             @map("recorded_by_user_id")
  recordedByUser        User?               @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  attachmentAssetId     String?             @map("attachment_asset_id")
  attachmentAsset       FileAsset?          @relation("PaymentAttachments", fields: [attachmentAssetId], references: [id], onDelete: SetNull)
  idempotencyKey        String?             @unique @map("idempotency_key")
  externalPaymentId     String?             @map("external_payment_id")
  allocations           PaymentAllocation[]
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  @@index([paidAt])
  @@index([counterpartyPartnerId, paidAt])
  @@index([direction, kind, paidAt])
  @@map("payment_records")
}

/// How much of a payment settled which receivable or instalment. Negative for a refund.
model PaymentAllocation {
  id                  String             @id @default(cuid())
  paymentRecordId     String             @map("payment_record_id")
  paymentRecord       PaymentRecord      @relation(fields: [paymentRecordId], references: [id], onDelete: Cascade)
  receivableId        String?            @map("receivable_id")
  receivable          Receivable?        @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  payableInstalmentId String?            @map("payable_instalment_id")
  payableInstalment   PayableInstalment? @relation(fields: [payableInstalmentId], references: [id], onDelete: Restrict)
  amountCents         Int                @map("amount_cents")
  createdAt           DateTime           @default(now()) @map("created_at")

  @@index([receivableId])
  @@index([payableInstalmentId])
  @@index([paymentRecordId])
  @@map("payment_allocations")
}

// ---------------------------------------------------------------------------
// Roles and capabilities
//
// A capability is a string named in code (`lib/permissions.js`), because each
// one is a check somewhere in the code and a row cannot invent a check. Which
// capabilities a role carries, which roles a user holds, and the odd one
// granted or taken from a user by name, are data.
// ---------------------------------------------------------------------------

/// Which side of the platform a role belongs to. A platform role is held by
/// staff and drivers, who carry no partnerId; a partner role by a company's
/// people, who always do. A trigger keeps every user's roles on one side.
enum RoleSide {
  PLATFORM
  PARTNER

  @@map("role_side")
}

enum OverrideEffect {
  GRANT
  DENY

  @@map("override_effect")
}

/// A named set of capabilities. The system roles are seeded by migration and
/// keep their key and side for good; what each may do is data. (`AccessRole`
/// because `Role` is the enum on `users.role`, which stays until the column goes.)
model AccessRole {
  id          String   @id @default(cuid())
  /// The stable name code, seeds and tests use: `SUPER_ADMIN`, `PARTNER_AGENT`.
  key         String   @unique
  name        String
  description String?
  side        RoleSide
  /// Seeded: cannot be deleted, and keeps its key and side.
  isSystem    Boolean  @default(false) @map("is_system")
  /// Lower first; the lowest of a user's roles is its primary role.
  sortOrder   Int      @default(0) @map("sort_order")

  capabilities RoleCapability[]
  members      UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model RoleCapability {
  roleId     String     @map("role_id")
  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  capability String

  @@id([roleId, capability])
  @@index([capability])
  @@map("role_capabilities")
}

model UserRole {
  userId          String   @map("user_id")
  user            User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  roleId          String     @map("role_id")
  role            AccessRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedByUserId String?    @map("granted_by_user_id")
  grantedAt       DateTime   @default(now()) @map("granted_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// One capability granted to, or taken from, one user by name, with a reason
/// and optionally a last day. Applied after the roles: a GRANT adds, a DENY
/// wins over anything a role gave.
model UserCapabilityOverride {
  id              String         @id @default(cuid())
  userId          String         @map("user_id")
  user            User           @relation("UserOverrides", fields: [userId], references: [id], onDelete: Cascade)
  capability      String
  effect          OverrideEffect
  reason          String
  expiresAt       DateTime?      @map("expires_at")
  grantedByUserId String?        @map("granted_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@unique([userId, capability])
  @@map("user_capability_overrides")
}

// ---------------------------------------------------------------------------
// Approvals
//
// A money action one person asks for and another approves: the refund, the
// write-off, the override, the moved deadline. The request carries the
// exact input the executing service will run with; approving runs it, in
// the approver's name, in the same transaction that marks the request
// approved — so a request is either done or still pending, never half.
// ---------------------------------------------------------------------------

enum ApprovalKind {
  REFUND
  PAYABLE_OVERRIDE
  PAYABLE_WAIVE
  RECEIVABLE_DUE_DATE
  RECEIVABLE_WAIVE
  PENALTY_OVERRIDE

  @@map("approval_kind")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("approval_status")
}

model ApprovalRequest {
  id        String         @id @default(cuid())
  reference String         @unique
  kind      ApprovalKind
  status    ApprovalStatus @default(PENDING)

  /// What the action is about: a receivable, a payable, or (for a refund) the receivable or instalment it settles.
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")
  /// The exact body the executing service runs with on approval.
  payload     Json
  amountCents Int?    @map("amount_cents")
  currency    String? @db.Char(3)
  summary     String

  requestedByUserId String?   @map("requested_by_user_id")
  requestedBy       User?     @relation("ApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestNote       String?   @map("request_note")
  decidedByUserId   String?   @map("decided_by_user_id")
  decidedBy         User?     @relation("ApprovalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt         DateTime? @map("decided_at")
  decisionNote      String?   @map("decision_note")

  /// What approving produced: the payment record, or the adjusted row.
  executedEntityType String? @map("executed_entity_type")
  executedEntityId   String? @map("executed_entity_id")
  /// Why the last approval attempt failed, left for the approver; the request stays pending.
  lastError          String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([requestedByUserId, status])
  @@index([subjectType, subjectId, status])
  @@map("approval_requests")
}

enum CreditLimitMode {
  BLOCK
  WARN

  @@map("credit_limit_mode")
}

enum AccessMode {
  ALLOW
  DENY

  @@map("access_mode")
}

/// What one partner may or may not sell, by product.
///
/// No rows: everything. A DENY row hides that product from the partner
/// wherever it is searched, quoted or booked. One or more ALLOW rows for a
/// product type turn that type into an allow-list for the partner. Read with
/// the session, so every catalogue query applies it without another round
/// trip.
model PartnerProductAccess {
  id        String  @id @default(cuid())
  partnerId String  @map("partner_id")
  partner   Partner @relation("PartnerProductAccess", fields: [partnerId], references: [id], onDelete: Cascade)

  productType PricingProductType @map("product_type")
  /// A hotel, vehicle class, tour, service or package id.
  productId   String             @map("product_id")
  mode        AccessMode
  note        String?

  createdByUserId String? @map("created_by_user_id")
  createdByUser   User?   @relation("ProductAccessCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([partnerId, productType, productId])
  @@index([productType, productId])
  @@map("partner_product_access")
}

/// What a cancellation cost the buyer, as a row finance works from: the
/// charge as the policy calculated it, and the figure a second person
/// approved in its place, which the ledger then owes instead.
model PenaltyEntry {
  id              String         @id @default(cuid())
  bookingType     FinanceProduct @map("booking_type")
  bookingId       String         @map("booking_id")
  reference       String
  partnerId       String?        @map("partner_id")
  partner         Partner?       @relation("PartnerPenalties", fields: [partnerId], references: [id], onDelete: SetNull)
  currency        String         @db.Char(3)
  chargeCents     Int            @map("charge_cents")
  overrideCents   Int?           @map("override_cents")
  overrideReason  String?        @map("override_reason")
  approvalId      String?        @map("approval_id")
  createdByUserId String?        @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([bookingType, bookingId])
  @@index([partnerId, createdAt])
  @@map("penalty_entries")
}
