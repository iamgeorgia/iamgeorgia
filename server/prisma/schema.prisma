// Schema mirrors the domain types the client already renders from
// `client/types` — see destination.ts, hotel.ts, tour.ts, experience.ts.
//
// Conventions:
//   * Prisma models are PascalCase, Postgres tables/columns are snake_case
//     (@map / @@map), so hand-written SQL never needs quoted identifiers.
//   * Foreign keys point at immutable `id` columns. Every entity also keeps a
//     unique `slug` for URL lookups, but a slug can be renamed without
//     rewriting child rows.
//   * Money is stored as integer cents. Floats cannot represent money exactly
//     and whole units cannot represent $189.50.
//   * Nested value objects that are always read whole and never queried on
//     their own (galleries, policies, travel info) are Json, validated by the
//     zod schemas in validation/domain.js. Anything filtered, sorted or
//     paginated gets its own table.
//   * Enum values are spelled exactly like the client's string unions, so the
//     API needs no translation layer.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum PropertyType {
  Hotel
  Boutique
  Resort
  Guesthouse
  Lodge
  Apartment
  Chalet
  Hostel
  Villa

  @@map("property_type")
}

/// Amenities were a closed enum in the prototype. They are a table now: adding
/// "Ski Storage" must not be a schema migration, and an enum array cannot carry
/// a per-hotel note like "Parking — 15 GEL/night".
enum AmenityCategory {
  General
  FoodDrink
  Wellness
  Parking
  Business
  Family
  Ski
  Accessibility
  Transportation
  /// The three below group the facilities an observant traveller filters on.
  /// Categories rather than a code prefix, because a category is already what
  /// the admin checklist groups by and what the client renders as a filter
  /// group — so three sections come for free. Shabbat and Religious are not
  /// kosher-specific on purpose: a prayer room and a step-free entrance are
  /// both facilities, and the next specialised requirement should be able to
  /// reuse the same machinery.
  KosherFood
  Shabbat
  Religious

  @@map("amenity_category")
}

/// Whether an amenity describes a property, a room, or reads sensibly as both.
/// "Airport Shuttle" is never a room amenity; "Air Conditioning" is both.
enum AmenityScope {
  HOTEL
  ROOM
  BOTH

  @@map("amenity_scope")
}

/// Standardised board codes. Global rather than per-hotel so that "show me
/// every half-board offer in Bakuriani" is a comparable filter; each hotel adds
/// its own inclusions and service times through HotelMealPlan.
enum MealPlanCode {
  RO
  BB
  HB
  HB_PLUS
  FB
  FB_PLUS
  AI
  UAI

  @@map("meal_plan_code")
}

enum CancellationKind {
  FLEXIBLE
  NON_REFUNDABLE
  TIERED

  @@map("cancellation_kind")
}

/// What a cancellation charge is a proportion of. PERCENT_* carry basis points
/// in `chargeValue`; FIXED_AMOUNT carries minor units; NIGHTS carries a count
/// of nights and is charged as the sum of those actual nights, not an average.
enum ChargeBasis {
  PERCENT_OF_TOTAL
  PERCENT_OF_FIRST_NIGHT
  FIXED_AMOUNT
  NIGHTS

  @@map("charge_basis")
}

/// Kept entirely separate from cancellation because in B2B the two vary
/// independently: a non-refundable rate can still settle on a credit account
/// thirty days after checkout.
enum PaymentTiming {
  PAY_NOW
  PAY_LATER
  DEPOSIT
  PAY_AT_HOTEL
  CREDIT_ACCOUNT

  @@map("payment_timing")
}

enum HotelBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@map("hotel_booking_status")
}

enum BookingRoomStatus {
  CONFIRMED
  CANCELLED

  @@map("booking_room_status")
}

enum HoldStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED

  @@map("hold_status")
}

enum BookingGuestType {
  ADULT
  CHILD
  INFANT

  @@map("booking_guest_type")
}

enum TaxFeeBasis {
  PERCENT
  PER_NIGHT_PER_PERSON
  PER_NIGHT_PER_ROOM
  PER_STAY

  @@map("tax_fee_basis")
}

enum RatePlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("rate_plan_status")
}

/// PARTNER_ONLY is the B2B hook: a negotiated rate that never appears in a
/// public search result. Nothing consumes it yet, but the column means adding
/// partner-only pricing later is a filter, not a migration.
enum RatePlanVisibility {
  PUBLIC
  PARTNER_ONLY

  @@map("rate_plan_visibility")
}

enum RoomTypeStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("room_type_status")
}

enum BedTypeCode {
  SINGLE
  TWIN
  DOUBLE
  QUEEN
  KING
  SOFA
  BUNK
  FUTON

  @@map("bed_type_code")
}

enum BathroomType {
  PRIVATE
  ENSUITE
  SHARED

  @@map("bathroom_type")
}

/// How a child in an age band is charged. PERCENT_OF_ADULT and FIXED_PER_NIGHT
/// carry their value in `chargeValue` — basis points and minor units
/// respectively, the same integer discipline as every other rate here.
enum ChildChargeMode {
  FREE
  PERCENT_OF_ADULT
  FIXED_PER_NIGHT
  FULL_ADULT

  @@map("child_charge_mode")
}

enum DestinationType {
  COUNTRY
  REGION
  CITY
  RESORT

  @@map("destination_type")
}

/// A hotel is never deleted once it has booking history, so there is no delete
/// — there is a lifecycle. DRAFT is invisible everywhere including search;
/// ARCHIVED is terminal.
enum HotelStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED

  @@map("hotel_status")
}

/// Which AvailabilityProvider owns this hotel's inventory. Only MANUAL is
/// implemented; the column exists so that adding a channel manager later is a
/// new provider rather than a change to search and booking.
enum InventorySource {
  MANUAL
  CHANNEL_MANAGER
  SUPPLIER_API

  @@map("inventory_source")
}

/// How much of a property's operation is kosher.
///
/// Deliberately *not* a single "kosher status" scale. Scope of service and
/// assurance are independent facts: a fully kosher property may hold no
/// certificate, and a certified one may be certified for its restaurant only.
/// Collapsing them into one enum would make "certified" something an admin can
/// simply assert, and would leave nowhere to store the day a certificate
/// lapses. So certification is *not expressible here* — it is derived from
/// HotelKosherCertification rows and from today's date.
///
/// Declared weakest-first: the search filter compares positions in
/// `enum_range()`, so the declaration order is the ordering.
enum KosherServiceLevel {
  /// Asked, and the answer was no. Kept so the question is not re-asked, and
  /// so a profile can be stood down without losing its certification history.
  NONE
  /// Kosher meals arranged with notice. The property is not otherwise kosher.
  ON_REQUEST
  /// Accommodates observant guests — Shabbat arrangements, nearby facilities —
  /// without a kosher kitchen of its own.
  KOSHER_FRIENDLY
  /// A kosher outlet or kitchen inside a property that is not.
  PARTIAL
  /// The whole property operates kosher.
  FULL

  @@map("kosher_service_level")
}

/// What a certificate actually covers.
///
/// A restaurant certificate is not a property certificate, and presenting one
/// as the other is the specific misrepresentation this column exists to stop:
/// only PROPERTY and KITCHEN satisfy a "kosher certified property" filter.
enum KosherCertificationScope {
  PROPERTY
  KITCHEN
  RESTAURANT
  PASSOVER

  @@map("kosher_certification_scope")
}

/// A human decision about a certificate.
///
/// EXPIRED is absent on purpose. Expiry is a function of `expiresOn` and
/// today, derived on every read, so it is correct at 00:01 whether or not any
/// job has run. A stored EXPIRED would be wrong for exactly as long as the gap
/// between midnight and the next sweep — which is the one failure this whole
/// subsystem exists to prevent.
enum KosherVerification {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED

  @@map("kosher_verification")
}

/// Who asserted this.
///
/// The whole point of the column is that a SUPPLIER import may not silently
/// overwrite what an ADMIN reviewed. VERIFIED is deliberately not a value here:
/// verification is a state of a certificate, not a source of data.
enum KosherDataSource {
  ADMIN
  HOTEL
  SUPPLIER
  IMPORT

  @@map("kosher_data_source")
}

/// The life of one structured requirement on a booking.
enum BookingRequestStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  WITHDRAWN

  @@map("booking_request_status")
}

enum FileVisibility {
  PUBLIC
  PRIVATE

  @@map("file_visibility")
}

enum FileCategory {
  HOTEL_IMAGE
  ROOM_IMAGE
  AMENITY_ICON
  CONTRACT
  RATE_SHEET
  INVOICE
  VOUCHER
  IMPORT
  /// A scan or photograph of a kosher certificate. PRIVATE, like every other
  /// document category: a scan of a signed certificate on a permanent public
  /// URL is a forgeable artefact, so the bytes are reached through a signed,
  /// audited request and the *facts* travel in the API response instead.
  KOSHER_CERTIFICATE
  /// Photographs of a fleet car and of a driver: PUBLIC, they are shown to the
  /// partner and the traveller meeting the car.
  FLEET_IMAGE
  DRIVER_PHOTO
  /// Licences, insurance, inspections, ID scans: PRIVATE, reached only through
  /// a signed, audited request by operations staff.
  DRIVER_DOCUMENT
  VEHICLE_DOCUMENT
  /// Photographs of a tour: PUBLIC, shown on the catalogue page.
  TOUR_IMAGE
  /// Photographs of a package: PUBLIC.
  PACKAGE_IMAGE
  /// Proof of a payment — a bank slip, a transfer confirmation. PRIVATE.
  PAYMENT_ATTACHMENT
  OTHER

  @@map("file_category")
}

enum ImageCategory {
  Exterior
  Lobby
  Restaurant
  Pool
  Spa
  Room
  Bathroom
  View
  Facilities

  @@map("image_category")
}

enum TourCategory {
  adventure
  culture
  wine
  nature
  city

  @@map("tour_category")
}

enum Difficulty {
  Easy
  Moderate
  Challenging

  @@map("difficulty")
}

enum ExperienceCategory {
  wine
  food
  adventure
  culture
  wellness
  craft

  @@map("experience_category")
}

/// The same lifecycle as HotelStatus, and for the same reason: a tour with
/// booking history is retired, never deleted.
enum TourStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("tour_status")
}

enum TourOptionStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("tour_option_status")
}

/// SHARED sells seats on a departure other parties join; PRIVATE sells the
/// whole departure to one party.
enum TourOptionKind {
  SHARED
  PRIVATE

  @@map("tour_option_kind")
}

enum TourPricingBasis {
  PER_PERSON
  PER_GROUP

  @@map("tour_pricing_basis")
}

/// What one unit of inventory is. A SHARED option counts seats; a PRIVATE
/// option counts groups — one booking, however large, is one unit.
enum TourUnitKind {
  SEAT
  GROUP

  @@map("tour_unit_kind")
}

/// Only affects how inventory rows are generated. SCHEDULED rows are written
/// by hand for the dates a departure runs; ON_DEMAND rows are generated for
/// every operating weekday across the horizon.
enum TourScheduleKind {
  SCHEDULED
  ON_DEMAND

  @@map("tour_schedule_kind")
}

/// Whether a booking is confirmed the moment it is written, or waits for the
/// operator. Shared by tours and services; hotels and transfers are always
/// INSTANT.
enum ConfirmationMode {
  INSTANT
  ON_REQUEST

  @@map("confirmation_mode")
}

enum TourBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@map("tour_booking_status")
}

/// A priced service sold on its own line: kosher meals delivered to a hotel,
/// a mashgiach for a stay, a synagogue transfer. No inventory; the operator
/// confirms what needs confirming.
enum ServiceStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("service_status")
}

enum ServiceCategory {
  KOSHER_MEAL_DELIVERY
  SHABBAT_MEALS
  MASHGIACH
  SYNAGOGUE_TRANSFER
  GUIDE
  EQUIPMENT
  OTHER

  @@map("service_category")
}

/// What one unit of the price buys.
enum ServiceBasis {
  PER_PERSON
  PER_GROUP
  PER_DAY
  PER_PERSON_PER_DAY

  @@map("service_basis")
}

enum ServiceBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@map("service_booking_status")
}

enum PackageStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("package_status")
}

/// The kind of thing a package slot resolves to. Each type reads its own
/// constraint columns on the component and its own quote engine.
enum PackageComponentType {
  HOTEL_STAY
  TRANSFER
  TOUR
  SERVICE

  @@map("package_component_type")
}

/// How a package moves its price away from the sum of its parts.
enum PackageAdjustmentKind {
  NONE
  DISCOUNT_BPS
  FIXED_SELL
  PER_PERSON_FIXED

  @@map("package_adjustment_kind")
}

enum PackageAdjustmentScope {
  REQUIRED_ONLY
  ALL_ITEMS

  @@map("package_adjustment_scope")
}

/// How many units of a SERVICE slot an order takes.
enum PackageQuantityRule {
  ONE
  PER_PERSON
  PER_ROOM

  @@map("package_quantity_rule")
}

/// How Shabbat is located in time for a kosher package: from sunset at the
/// property's coordinates, from published fixed hours, or not at all.
enum ShabbatMode {
  SOLAR
  FIXED_HOURS
  NONE

  @@map("shabbat_mode")
}

enum OrderKind {
  PACKAGE
  CUSTOM

  @@map("order_kind")
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PARTIALLY_CANCELLED
  CANCELLED
  COMPLETED

  @@map("order_status")
}

enum OrderItemStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@map("order_item_status")
}

/// Who fulfils an item. EXTERNAL is reserved for a supplier reached over the
/// wire after commit; nothing sets it yet.
enum OrderItemFulfilment {
  INTERNAL
  ON_REQUEST
  EXTERNAL

  @@map("order_item_fulfilment")
}

/// The product dimension of a pricing rule. Null on a rule means any product.
enum PricingProductType {
  HOTEL
  TRANSFER
  TOUR
  SERVICE
  PACKAGE

  @@map("pricing_product_type")
}

model Destination {
  id   String          @id @default(cuid())
  slug String          @unique
  name String
  type DestinationType @default(CITY)

  /// Country -> Region -> City/Resort, as a self-reference rather than three
  /// tables: depth varies by country, and a fixed three-level shape would force
  /// empty rows for places that do not have a meaningful region.
  parentId String?       @map("parent_id")
  parent   Destination?  @relation("DestinationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Destination[] @relation("DestinationTree")

  /// Materialised ancestry, e.g. `/georgia/samtskhe-javakheti/bakuriani`.
  /// Searching a whole country is then `path LIKE '/georgia/%'` — one index
  /// scan per search instead of a recursive CTE. Rewritten by the service when
  /// a destination is created or moved, which happens a few times a year.
  path String

  /// Denormalised onto every level so a country filter never walks the tree.
  countryCode String @map("country_code") @db.Char(2)

  /// Plain float8, matching what PostGIS stores internally. Coordinates are not
  /// money: there is nothing here that decimal arithmetic would protect.
  latitude  Float?
  longitude Float?

  /// Maintained by a trigger from latitude/longitude. Prisma can neither read
  /// nor write a PostGIS type, which is fine — every geographic query is raw
  /// SQL, and having one writer means the point can never disagree with the
  /// columns it is derived from.
  geo Unsupported("geography(Point, 4326)")?

  /// PlaceRef — what Google Places said about this position when it was
  /// chosen: place id, formatted address, city, country. Read whole and never
  /// queried; null for a pin placed by hand or before place search existed.
  /// The coordinates above stay the source of truth for everything geographic.
  place Json?

  /// IANA, e.g. `Asia/Tbilisi`. Hotels inherit this unless they override it,
  /// and it is what turns a cancellation deadline into an absolute instant.
  timezone String @default("Asia/Tbilisi")

  /// Short editorial line used on covers and hero overlays.
  tagline     String?
  /// One-sentence summary for cards and metadata.
  summary     String?
  description String[]

  /// Still plain paths: destination artwork is editorial and outside the hotel
  /// media pipeline. Hotel and room imagery goes through FileAsset.
  heroImage  String? @map("hero_image")
  /// Portrait crop used by the magazine-style destination index.
  coverImage String? @map("cover_image")
  /// GalleryImage[]
  gallery    Json    @default("[]")

  idealFor    String[] @map("ideal_for")
  /// Attraction[]
  attractions Json     @default("[]")
  /// TravelInfo
  travelInfo  Json?    @map("travel_info")

  featured Boolean @default(false)

  hotels         Hotel[]
  pricingRules   PricingRule[]
  tours          Tour[]
  experiences    Experience[]
  transferPoints TransferPoint[]
  translations   DestinationTranslation[]

  services  Service[]
  packages  Package[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([type, countryCode])
  @@index([featured])
  @@index([path])
  @@map("destinations")
}

/// A property. Content only — no price and no availability live here, so the
/// whole table can be cached and served publicly without touching anything
/// commercially sensitive.
model Hotel {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  propertyType PropertyType @map("property_type")
  status       HotelStatus  @default(DRAFT)

  /// The partner company that supplies this property. PartnerKind.HOTEL existed
  /// from the start but nothing joined a supplier to a property; this is that
  /// join, and it is what every supplier-scoped authorization check reads.
  /// Restrict, not Cascade: deleting a partner that still has hotels must fail
  /// loudly rather than take the inventory with it.
  supplierId String?  @map("supplier_id")
  supplier   Partner? @relation("PartnerHotels", fields: [supplierId], references: [id], onDelete: Restrict)

  destinationId String      @map("destination_id")
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  address     String?
  postalCode  String? @map("postal_code")
  /// Denormalised from the destination so a country filter never joins.
  countryCode String  @map("country_code") @db.Char(2)

  latitude  Float?
  longitude Float?
  geo       Unsupported("geography(Point, 4326)")?
  /// PlaceRef, as on Destination. `address` stays the operator's own wording
  /// of the door; this is what the place search returned.
  place     Json?

  /// Wall-clock times at the property, `HH:MM`. Deliberately not timestamps:
  /// "check-in from 14:00" is a local fact, not an instant.
  checkInFrom   String? @map("check_in_from")
  checkInUntil  String? @map("check_in_until")
  checkOutFrom  String? @map("check_out_from")
  checkOutUntil String? @map("check_out_until")

  /// IANA. Inherited from the destination on create, overridable. Load-bearing:
  /// cancellation deadlines and "is this date still bookable" are resolved in
  /// it, and a wrong value here is an off-by-one-night bug.
  timezone String @default("Asia/Tbilisi")

  /// ISO-4217. The currency this property is contracted in; every rate and
  /// every booking total carries a currency alongside its amount.
  currency String @default("GEL") @db.Char(3)

  phone     String?
  email     String?
  website   String?
  languages String[]

  /// Which AvailabilityProvider owns this hotel's inventory, and whatever that
  /// provider needs to identify the property upstream.
  sourceType  InventorySource @default(MANUAL) @map("source_type")
  externalRef Json?           @map("external_ref")

  /// Official star classification, 1-5.
  starRating  Int   @map("star_rating")
  /// Guest score out of 10, as travellers expect from booking platforms.
  guestScore  Float @default(0) @map("guest_score")
  reviewCount Int   @default(0) @map("review_count")

  shortDescription String?  @map("short_description")
  summary          String?
  description      String[]

  /// ReviewCategoryScore[]
  categoryScores Json @default("[]") @map("category_scores")
  /// HotelPolicies — prose, read whole, never queried. The machine-readable
  /// cancellation terms live in CancellationPolicy/CancellationRule.
  policies       Json @default("{}")
  /// NearbyPlace[]
  nearby         Json @default("[]")

  featuredImageId String?    @map("featured_image_id")
  featuredImage   FileAsset? @relation("HotelFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)

  /// Whether this property is sold to the public at all. Everything is B2B by
  /// default — partners see the whole ACTIVE catalogue — and a hotel appears
  /// to anonymous visitors only when this is switched on deliberately.
  b2cEnabled Boolean @default(false) @map("b2c_enabled")

  /// Lowest nightly rate across rate plans, in minor units. A denormalised
  /// cache for the un-dated browse page only — never used to quote or to book,
  /// because a "from" price with no dates is not an offer.
  priceFromCents    Int?    @map("price_from_cents")
  priceFromCurrency String? @map("price_from_currency") @db.Char(3)

  featured Boolean @default(false)

  reviews              Review[]
  roomTypes            RoomType[]
  childPolicy          ChildPolicy?
  mealPlans            HotelMealPlan[]
  cancellationPolicies CancellationPolicy[]
  paymentPolicies      PaymentPolicy[]
  taxFees              HotelTaxFee[]
  bookings             HotelBooking[]
  pricingRules         PricingRule[]
  amenities            HotelAmenity[]
  images               HotelImage[]
  documents            HotelDocument[]
  translations         HotelTranslation[]

  /// The kosher offering. Optional, and its *existence* is the switch: a hotel
  /// with no row here shows no kosher block anywhere, matches no kosher filter
  /// and renders no kosher admin section. Kept off this table rather than as
  /// columns on it because these fields need their own endpoint, their own
  /// authorization and their own audit actions — the same reasoning that keeps
  /// `status` out of `updateHotelSchema`.
  kosher HotelKosherProfile?

  packageComponents PackageComponent[]
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  /// When and how this supplier is paid, and what it is owed after a cancellation.
  paymentTerms      SupplierPaymentTerms?

  @@index([destinationId, status])
  @@index([supplierId])
  @@index([status, featured])
  @@index([countryCode])
  @@index([priceFromCents])
  @@map("hotels")
}

model Review {
  id      String @id @default(cuid())
  hotelId String @map("hotel_id")
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  author   String
  country  String
  date     DateTime
  /// Hotel reviews use the 10-point scale.
  score    Float
  title    String
  body     String
  tripType String   @map("trip_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hotelId, date])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Tours.
//
// Tour -> TourOption -> (TourSeason/TourSeasonTier, TourInventory) mirrors
// Hotel -> RoomType -> RatePlan for the same reason: one "Kazbegi day trip"
// sold as a shared minibus seat and as a private car is one tour, two options,
// two inventories and two price sheets. Collapsing the option into the tour is
// what forces duplicate tours and, from there, oversold departures.
//
// Inventory is a counter table keyed by (option, date), shaped exactly like
// room_inventory and claimed through the same statement. A scheduled departure
// is a row that exists; an on-demand day is a row the generator wrote; a
// blackout is stop_sell. Multi-day tours claim the departure date only — an
// operator's capacity is "how many groups start on Monday", not per night.
// ---------------------------------------------------------------------------

model Tour {
  id       String     @id @default(cuid())
  slug     String     @unique
  title    String
  location String
  status   TourStatus @default(DRAFT)

  /// The operator that runs it. Optional and Restrict — the same seam as
  /// Hotel.supplierId, so a platform-run and a partner-run tour are one row
  /// type and a partner with tours cannot be deleted from under them.
  supplierId String?  @map("supplier_id")
  supplier   Partner? @relation("PartnerTours", fields: [supplierId], references: [id], onDelete: Restrict)

  destinationId String      @map("destination_id")
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  category    TourCategory
  summary     String
  description String[]
  image       String
  /// GalleryImage[] — the editorial gallery the fixtures carried. Uploaded
  /// media attaches through TourImage.
  gallery     Json         @default("[]")

  durationDays  Int        @map("duration_days")
  durationLabel String     @map("duration_label")
  groupSize     String     @map("group_size")
  difficulty    Difficulty

  /// IANA. "Day one, 08:00" is a wall-clock fact here, and a cancellation
  /// deadline is resolved in it.
  timezone String @default("Asia/Tbilisi")
  /// ISO-4217, the currency every season under every option is quoted in.
  currency String @default("GEL") @db.Char(3)

  /// Where the day starts: structured when it is a known pick-up point, and
  /// prose in `meetingPoint` always, because "your hotel lobby" is not a
  /// coordinate.
  meetingPointId  String?        @map("meeting_point_id")
  meetingPointRef TransferPoint? @relation("TourMeetingPoint", fields: [meetingPointId], references: [id], onDelete: SetNull)
  meetingTime     String?        @map("meeting_time")
  meetingPoint    String         @map("meeting_point")

  minAge       Int? @map("min_age")
  /// The two age lines a child policy draws, on the tour itself: a trek and a
  /// wine tour disagree about who is a child.
  infantMaxAge Int  @default(2) @map("infant_max_age")
  childMaxAge  Int  @default(11) @map("child_max_age")

  /// Lowest adult sell price across active options, in minor units. A
  /// derived cache for the un-dated browse page, refreshed by the season
  /// editor and never used to quote or to book.
  priceFromCents Int   @default(0) @map("price_from_cents")
  /// 5-point star rating.
  rating         Float @default(0)
  reviewCount    Int   @default(0) @map("review_count")

  highlights    String[]
  included      String[]
  excluded      String[]
  importantInfo String[] @map("important_info")

  /// Sold to the public at all. B2B by default, exactly as Hotel.b2cEnabled.
  b2cEnabled Boolean @default(false) @map("b2c_enabled")
  featured   Boolean @default(false)

  itinerary    ItineraryDay[]
  options      TourOption[]
  images       TourImage[]
  translations TourTranslation[]
  bookings     TourBooking[]

  kosher            TourKosherProfile?
  packageComponents PackageComponent[]
  pricingRules      PricingRule[]
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  /// When and how this supplier is paid, and what it is owed after a cancellation.
  paymentTerms      SupplierPaymentTerms?

  @@index([destinationId, status])
  @@index([supplierId])
  @@index([category])
  @@index([status, featured])
  @@map("tours")
}

model ItineraryDay {
  id     String @id @default(cuid())
  tourId String @map("tour_id")
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  day           Int
  title         String
  description   String
  meals         String[]
  accommodation String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tourId, day])
  @@map("itinerary_days")
}

model Experience {
  id       String @id @default(cuid())
  slug     String @unique
  title    String
  location String

  destinationId String      @map("destination_id")
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  category    ExperienceCategory
  summary     String
  description String[]
  image       String
  /// GalleryImage[]
  gallery     Json               @default("[]")

  duration    String
  groupSize   String @map("group_size")
  /// Per-person price in cents.
  priceCents  Int    @map("price_cents")
  /// 5-point star rating.
  rating      Float
  reviewCount Int    @default(0) @map("review_count")

  highlights   String[]
  /// ExpectationStep[]
  whatToExpect Json     @default("[]") @map("what_to_expect")
  included     String[]

  featured Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([destinationId])
  @@index([category])
  @@index([featured])
  @@map("experiences")
}

/// The sellable variant of a tour: shared seat or private group, per person
/// or per group, scheduled or on demand. The thing a price attaches to and
/// the thing inventory is counted on.
model TourOption {
  id     String @id @default(cuid())
  tourId String @map("tour_id")
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  code      String
  name      String
  status    TourOptionStatus @default(ACTIVE)
  sortOrder Int              @default(0) @map("sort_order")

  kind             TourOptionKind
  pricingBasis     TourPricingBasis   @map("pricing_basis")
  unitKind         TourUnitKind       @map("unit_kind")
  scheduleKind     TourScheduleKind   @default(ON_DEMAND) @map("schedule_kind")
  confirmationMode ConfirmationMode   @default(INSTANT) @map("confirmation_mode")
  visibility       RatePlanVisibility @default(PUBLIC)

  /// Party size a single booking may carry. For SHARED it bounds one party;
  /// for PRIVATE it is the group size the price sheet is written for.
  minPax Int @default(1) @map("min_pax")
  maxPax Int @map("max_pax")

  /// Wall clock in the tour's timezone; a departure row may override it.
  startTime       String? @map("start_time")
  /// Day tours only. Multi-day tours read Tour.durationDays.
  durationMinutes Int?    @map("duration_minutes")

  languages          String[]
  /// ISO weekdays, 1 = Monday. Empty means every day. The ON_DEMAND
  /// generator reads this; SCHEDULED rows are written by hand.
  operatesOnWeekdays Int[]    @map("operates_on_weekdays")

  /// A booking closer than this to the start is refused; further ahead than
  /// the horizon is refused too.
  noticeHours Int @default(24) @map("notice_hours")
  horizonDays Int @default(365) @map("horizon_days")

  /// A platform template (CancellationPolicy.hotelId null) or a tour-owned
  /// policy. Percent-of-total tiers only; a night has no meaning here.
  cancellationPolicyId String             @map("cancellation_policy_id")
  cancellationPolicy   CancellationPolicy @relation(fields: [cancellationPolicyId], references: [id], onDelete: Restrict)

  seasons   TourSeason[]
  inventory TourInventory[]
  holds     TourHold[]
  bookings  TourBooking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tourId, code])
  @@index([tourId, status])
  @@index([cancellationPolicyId])
  @@map("tour_options")
}

/// A price sheet valid over a date window. Seasons, not per-date rows: a tour
/// price is a small matrix of traveller type by party-size tier, and a row per
/// date per tier is an editor nobody wants. Overlaps resolve by priority.
model TourSeason {
  id           String     @id @default(cuid())
  tourOptionId String     @map("tour_option_id")
  tourOption   TourOption @relation(fields: [tourOptionId], references: [id], onDelete: Cascade)

  name       String
  validFrom  DateTime @map("valid_from") @db.Date
  /// Inclusive.
  validUntil DateTime @map("valid_until") @db.Date
  /// ISO weekdays; empty means every day. A weekend supplement is its own
  /// season with a higher priority.
  weekdays   Int[]
  priority   Int      @default(0)
  currency   String   @db.Char(3)
  isActive   Boolean  @default(true) @map("is_active")

  tiers TourSeasonTier[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tourOptionId, validFrom, validUntil])
  @@map("tour_seasons")
}

/// One party-size tier of a season. PER_PERSON options read the per-traveller
/// columns; PER_GROUP options read the group columns. A fixed sell price
/// overrides the markup, exactly as Rate.sellCents does.
model TourSeasonTier {
  id       String     @id @default(cuid())
  seasonId String     @map("season_id")
  season   TourSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  minPax Int  @map("min_pax")
  /// Null means open-ended.
  maxPax Int? @map("max_pax")

  adultNetCents  Int? @map("adult_net_cents")
  childNetCents  Int? @map("child_net_cents")
  infantNetCents Int  @default(0) @map("infant_net_cents")
  groupNetCents  Int? @map("group_net_cents")

  adultSellCents Int? @map("adult_sell_cents")
  childSellCents Int? @map("child_sell_cents")
  groupSellCents Int? @map("group_sell_cents")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, minPax])
  @@map("tour_season_tiers")
}

/// Capacity on one departure date. Shaped exactly like RoomInventory and
/// claimed through the same statement; availability is derived on read and a
/// CHECK in the migration says the four counters can never add up to an
/// oversell.
model TourInventory {
  tourOptionId String     @map("tour_option_id")
  tourOption   TourOption @relation(fields: [tourOptionId], references: [id], onDelete: Cascade)
  /// The departure date, never an instant.
  date         DateTime   @db.Date

  totalUnits   Int @map("total_units")
  blockedUnits Int @default(0) @map("blocked_units")
  bookedUnits  Int @default(0) @map("booked_units")
  heldUnits    Int @default(0) @map("held_units")

  stopSell Boolean @default(false) @map("stop_sell")

  /// Overrides TourOption.startTime for this departure.
  departureTime String? @map("departure_time")
  /// Operational: "guide: Nino".
  note          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tourOptionId, date])
  @@index([date])
  @@map("tour_inventory")
}

/// Inventory claimed by a checkout in progress. Its own table rather than a
/// widened BookingHold: every hold row must name real inventory, and making
/// the room columns nullable to share the table would weaken that.
model TourHold {
  id    String @id @default(cuid())
  token String @unique

  tourOptionId String     @map("tour_option_id")
  tourOption   TourOption @relation(fields: [tourOptionId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  /// Units, not people: pax for a SEAT option, one for a GROUP option.
  quantity  Int      @default(1)
  adults    Int
  childAges Int[]    @map("child_ages")

  quotedNetCents  Int    @map("quoted_net_cents")
  quotedSellCents Int    @map("quoted_sell_cents")
  currency        String @db.Char(3)

  status    HoldStatus @default(ACTIVE)
  expiresAt DateTime   @map("expires_at")

  bookingId String?      @unique @map("booking_id")
  booking   TourBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdByUserId String?  @map("created_by_user_id")
  createdByUser   User?    @relation("TourHoldCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  partnerId       String?  @map("partner_id")
  partner         Partner? @relation("PartnerTourHolds", fields: [partnerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, expiresAt])
  @@index([tourOptionId, date])
  @@map("tour_holds")
}

/// A tour as it was sold: snapshot, frozen price lines, frozen cancellation
/// schedule. The foreign keys stay for reporting.
model TourBooking {
  id String @id @default(cuid())

  /// The public reference, e.g. TUR-000001, from a Postgres sequence.
  reference String @unique

  status TourBookingStatus @default(PENDING)

  idempotencyKey String? @unique @map("idempotency_key")

  partnerId      String?  @map("partner_id")
  partner        Partner? @relation("PartnerTourBookings", fields: [partnerId], references: [id], onDelete: SetNull)
  bookedByUserId String?  @map("booked_by_user_id")
  bookedByUser   User?    @relation("TourBookingBookedBy", fields: [bookedByUserId], references: [id], onDelete: SetNull)

  tourId       String      @map("tour_id")
  tour         Tour        @relation(fields: [tourId], references: [id], onDelete: Restrict)
  tourOptionId String?     @map("tour_option_id")
  tourOption   TourOption? @relation(fields: [tourOptionId], references: [id], onDelete: SetNull)

  /// The departure date, and the instant it resolves to in the tour's
  /// timezone. Both, because a roster wants a date and a deadline an instant.
  date    DateTime @db.Date
  endDate DateTime @map("end_date") @db.Date
  startAt DateTime @map("start_at")

  adults    Int
  childAges Int[] @map("child_ages")
  /// Inventory units this booking holds: pax for SEAT, one for GROUP.
  units     Int   @default(1)

  currency       String @db.Char(3)
  netTotalCents  Int    @map("net_total_cents")
  sellTotalCents Int    @map("sell_total_cents")
  markupBps      Int    @map("markup_bps")
  /// The agency's own commission rate when it booked, beside the markup actually applied (a pricing rule may have won).
  commissionRateBps Int? @map("commission_rate_bps")

  leadTravellerName  String  @map("lead_traveller_name")
  leadTravellerEmail String  @map("lead_traveller_email")
  leadTravellerPhone String? @map("lead_traveller_phone")
  specialRequests    String? @map("special_requests")
  /// Where to collect the party: "Hotel Vera, lobby".
  pickupNote         String? @map("pickup_note")

  /// The tour and option as they were sold. A voucher reads this.
  tourSnapshot Json @map("tour_snapshot")
  /// The quote's lines, frozen: what each traveller type cost.
  priceLines   Json @map("price_lines")

  cancellationSummary  String? @map("cancellation_summary")
  cancellationSchedule Json    @map("cancellation_schedule")

  /// Frozen from the option: an option switched to instant confirmation
  /// tomorrow does not confirm a request made today.
  confirmationMode  ConfirmationMode @map("confirmation_mode")
  requestedAt       DateTime?        @map("requested_at")
  requestDeadlineAt DateTime?        @map("request_deadline_at")
  declinedAt        DateTime?        @map("declined_at")
  declineReason     String?          @map("decline_reason")
  /// Idempotency stamp for the overdue-request sweeper: set in the same
  /// statement that enqueues the alert, so a crash cannot double-send.
  overdueAlertAt    DateTime?        @map("overdue_alert_at")

  confirmedAt             DateTime? @map("confirmed_at")
  cancelledAt             DateTime? @map("cancelled_at")
  cancellationChargeCents Int?      @map("cancellation_charge_cents")
  cancellationReason      String?   @map("cancellation_reason")
  completedAt             DateTime? @map("completed_at")

  /// Where it came from: web, partner API, admin.
  source String @default("web")

  travellers TourBookingTraveller[]
  hold       TourHold?

  orderItem  OrderItem?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  /// Finance: what we owe the supplier, and what the buyer owes us (standalone bookings only).
  payable    SupplierPayable?
  receivable Receivable?

  @@index([tourId, date])
  @@index([tourOptionId, date])
  @@index([partnerId, createdAt])
  @@index([status, date])
  @@map("tour_bookings")
}

/// One traveller, as booked. Per-person prices are kept on the line even for a
/// PER_GROUP option (where they are zero) so an invoice line and a future
/// amendment have the figure.
model TourBookingTraveller {
  id        String      @id @default(cuid())
  bookingId String      @map("booking_id")
  booking   TourBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type      BookingGuestType @default(ADULT)
  firstName String           @map("first_name")
  lastName  String           @map("last_name")
  /// Age on the departure date, frozen.
  age       Int?
  isLead    Boolean          @default(false) @map("is_lead")

  unitNetCents  Int @default(0) @map("unit_net_cents")
  unitSellCents Int @default(0) @map("unit_sell_cents")

  /// What an operator actually asks for on a multi-day tour.
  passportNumber String? @map("passport_number")
  nationality    String? @db.Char(2)
  dietary        String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([bookingId])
  @@map("tour_booking_travellers")
}

/// Shaped exactly like HotelImage so the same gallery service drives both.
model TourImage {
  id          String    @id @default(cuid())
  tourId      String    @map("tour_id")
  tour        Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  fileAssetId String    @map("file_asset_id")
  fileAsset   FileAsset @relation("TourImages", fields: [fileAssetId], references: [id], onDelete: Restrict)

  caption   String?
  sortOrder Int     @default(0) @map("sort_order")
  /// At most one per tour, enforced by a partial unique index in the migration.
  isCover   Boolean @default(false) @map("is_cover")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tourId, fileAssetId])
  @@index([tourId, sortOrder])
  @@map("tour_images")
}

/// Prose in a non-default locale, merged field by field over the English row.
model TourTranslation {
  id     String @id @default(cuid())
  tourId String @map("tour_id")
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  locale String

  title         String?
  location      String?
  summary       String?
  description   String[]
  highlights    String[]
  included      String[]
  excluded      String[]
  importantInfo String[] @map("important_info")
  meetingPoint  String?  @map("meeting_point")
  durationLabel String?  @map("duration_label")
  groupSize     String?  @map("group_size")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tourId, locale])
  @@map("tour_translations")
}

// ---------------------------------------------------------------------------
// Rooms.
//
// RoomType is the physical product and the thing inventory is counted on. It is
// deliberately not "a room": individual numbered rooms are not modelled,
// because no supplier in the pipeline assigns them at booking time and doing so
// would triple the inventory write path for nothing. Adding them later is a
// child table of RoomType and touches neither search nor booking.
//
// What is *not* here matters as much: no price, no meal plan, no cancellation
// terms. Those belong to RatePlan, which arrives in Phase 3. One Deluxe Double
// sold four ways is one RoomType and four RatePlans, and collapsing that
// distinction is what forces duplicate room types and, from there, oversold
// inventory.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Services, packages and orders.
//
// A Service is a priced line with no inventory. A Package is a template of
// typed slots resolved through the existing quote engines at quote time. An
// Order is the product-agnostic parent of one booking row per product,
// linked by exactly one nullable foreign key per item — enforced by a CHECK
// in the migration, because a polymorphic (type, id) pair cannot carry a
// foreign key and this schema does not do polymorphic joins.
// ---------------------------------------------------------------------------

model Service {
  id     String        @id @default(cuid())
  slug   String        @unique
  name   String
  status ServiceStatus @default(DRAFT)

  category ServiceCategory

  destinationId String?      @map("destination_id")
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  supplierId String?  @map("supplier_id")
  supplier   Partner? @relation("PartnerServices", fields: [supplierId], references: [id], onDelete: Restrict)

  basis     ServiceBasis
  /// Net cost of one unit, in minor units. The selling price is derived by the
  /// buyer's markup unless `sellCents` fixes it.
  netCents  Int          @map("net_cents")
  sellCents Int?         @map("sell_cents")
  currency  String       @default("GEL") @db.Char(3)
  timezone  String       @default("Asia/Tbilisi")

  minQuantity Int  @default(1) @map("min_quantity")
  maxQuantity Int? @map("max_quantity")

  cancellationPolicyId String             @map("cancellation_policy_id")
  cancellationPolicy   CancellationPolicy @relation(fields: [cancellationPolicyId], references: [id], onDelete: Restrict)

  noticeHours      Int              @default(48) @map("notice_hours")
  confirmationMode ConfirmationMode @default(INSTANT) @map("confirmation_mode")

  isKosher        Boolean @default(false) @map("is_kosher")
  kosherAuthority String? @map("kosher_authority")

  summary     String
  description String[]
  included    String[]

  b2cEnabled Boolean @default(false) @map("b2c_enabled")
  sortOrder  Int     @default(0) @map("sort_order")

  translations ServiceTranslation[]
  bookings     ServiceBooking[]
  components   PackageComponent[]
  pricingRules PricingRule[]

  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  /// When and how this supplier is paid, and what it is owed after a cancellation.
  paymentTerms SupplierPaymentTerms?

  @@index([status, category])
  @@index([destinationId, status])
  @@index([supplierId])
  @@map("services")
}

model ServiceTranslation {
  id        String  @id @default(cuid())
  serviceId String  @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  locale      String
  name        String?
  summary     String?
  description String[]
  included    String[]

  @@unique([serviceId, locale])
  @@map("service_translations")
}

/// A service as sold. No inventory and no hold — the transfer shape — but a
/// real row, so an order item can point at it and it carries its own frozen
/// terms, reference and audit trail like every other product.
model ServiceBooking {
  id String @id @default(cuid())

  reference String @unique

  status ServiceBookingStatus @default(PENDING)

  idempotencyKey String? @unique @map("idempotency_key")

  partnerId      String?  @map("partner_id")
  partner        Partner? @relation("PartnerServiceBookings", fields: [partnerId], references: [id], onDelete: SetNull)
  bookedByUserId String?  @map("booked_by_user_id")
  bookedByUser   User?    @relation("ServiceBookingBookedBy", fields: [bookedByUserId], references: [id], onDelete: SetNull)

  serviceId String  @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  date    DateTime @db.Date
  endDate DateTime @map("end_date") @db.Date
  startAt DateTime @map("start_at")

  quantity Int @default(1)
  pax      Int @default(1)
  days     Int @default(1)

  currency       String @db.Char(3)
  netTotalCents  Int    @map("net_total_cents")
  sellTotalCents Int    @map("sell_total_cents")
  markupBps      Int    @map("markup_bps")
  /// The agency's own commission rate when it booked, beside the markup actually applied (a pricing rule may have won).
  commissionRateBps Int? @map("commission_rate_bps")

  leadName  String  @map("lead_name")
  leadEmail String  @map("lead_email")
  leadPhone String? @map("lead_phone")
  notes     String?

  serviceSnapshot      Json @map("service_snapshot")
  cancellationSchedule Json @map("cancellation_schedule")

  confirmationMode  ConfirmationMode @map("confirmation_mode")
  requestedAt       DateTime?        @map("requested_at")
  requestDeadlineAt DateTime?        @map("request_deadline_at")
  declinedAt        DateTime?        @map("declined_at")
  declineReason     String?          @map("decline_reason")

  confirmedAt             DateTime? @map("confirmed_at")
  cancelledAt             DateTime? @map("cancelled_at")
  cancellationChargeCents Int?      @map("cancellation_charge_cents")
  cancellationReason      String?   @map("cancellation_reason")
  completedAt             DateTime? @map("completed_at")

  source String @default("web")

  orderItem OrderItem?

  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  /// Finance: what we owe the supplier, and what the buyer owes us (standalone bookings only).
  payable    SupplierPayable?
  receivable Receivable?

  @@index([serviceId, date])
  @@index([partnerId, createdAt])
  @@index([status, date])
  @@map("service_bookings")
}

/// An admin-defined template: a length, a destination, a price adjustment and
/// an ordered set of typed slots. Nothing about it is a price until it is
/// quoted for a date and a party, when each slot resolves to a live offer.
model Package {
  id     String        @id @default(cuid())
  slug   String        @unique
  name   String
  status PackageStatus @default(DRAFT)

  destinationId String      @map("destination_id")
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  summary     String
  description String[]
  /// Editorial cover under /public, until the gallery has an upload.
  image       String   @default("")
  gallery     Json     @default("[]")

  /// The package length. Slots address days as offsets from the start.
  nights   Int
  currency String @default("GEL") @db.Char(3)
  timezone String @default("Asia/Tbilisi")

  b2cEnabled Boolean @default(false) @map("b2c_enabled")
  featured   Boolean @default(false)
  sortOrder  Int     @default(0) @map("sort_order")

  minAdults   Int  @default(1) @map("min_adults")
  maxAdults   Int? @map("max_adults")
  maxChildren Int? @map("max_children")
  maxPax      Int? @map("max_pax")

  /// Applied to the sell side after each component's own markup, then
  /// allocated across the items pro rata and frozen onto the order.
  adjustmentKind      PackageAdjustmentKind  @default(NONE) @map("adjustment_kind")
  /// Basis points for DISCOUNT_BPS, minor units otherwise.
  adjustmentValue     Int                    @default(0) @map("adjustment_value")
  adjustmentAppliesTo PackageAdjustmentScope @default(REQUIRED_ONLY) @map("adjustment_applies_to")

  /// When it may be sold, and when the travel may fall.
  sellableFrom  DateTime? @map("sellable_from") @db.Date
  sellableUntil DateTime? @map("sellable_until") @db.Date
  validFrom     DateTime? @map("valid_from") @db.Date
  validUntil    DateTime? @map("valid_until") @db.Date

  /// A cached cheapest sample, refreshed by the sweeper. Indicative only.
  priceFromCents Int       @default(0) @map("price_from_cents")
  priceFromAt    DateTime? @map("price_from_at")

  /// An admin's dated decision to sell a kosher package whose hotel has lost
  /// eligibility. Audited; never a silent bypass.
  kosherOverrideUntil DateTime? @map("kosher_override_until") @db.Date

  components   PackageComponent[]
  images       PackageImage[]
  translations PackageTranslation[]
  kosher       KosherPackageProfile?
  orders       Order[]
  pricingRules PricingRule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([destinationId, status])
  @@index([status, featured])
  @@map("packages")
}

/// One slot of a package. The constraint columns are real columns because
/// the resolver filters on them and the panel edits them; `constraints` holds
/// only soft preferences.
model PackageComponent {
  id        String  @id @default(cuid())
  packageId String  @map("package_id")
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  slotIndex     Int                  @map("slot_index")
  componentType PackageComponentType @map("component_type")
  label         String
  required      Boolean              @default(true)

  /// Days from the package start. A HOTEL_STAY runs `nights` from there.
  dayOffset    Int                 @default(0) @map("day_offset")
  nights       Int?
  /// A pick-up or start time override, wall clock at the destination.
  timeOfDay    String?             @map("time_of_day")
  quantityRule PackageQuantityRule @default(ONE) @map("quantity_rule")

  // HOTEL_STAY: a fixed property, or any at the destination when null.
  hotelId              String?        @map("hotel_id")
  hotel                Hotel?         @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  allowedRoomTypeIds   String[]       @map("allowed_room_type_ids")
  allowedRatePlanIds   String[]       @map("allowed_rate_plan_ids")
  allowedMealPlanCodes MealPlanCode[] @map("allowed_meal_plan_codes")

  // TRANSFER
  fromPointId           String?                @map("from_point_id")
  fromPoint             TransferPoint?         @relation("PackageComponentFrom", fields: [fromPointId], references: [id], onDelete: SetNull)
  toPointId             String?                @map("to_point_id")
  toPoint               TransferPoint?         @relation("PackageComponentTo", fields: [toPointId], references: [id], onDelete: SetNull)
  routeId               String?                @map("route_id")
  route                 TransferRoute?         @relation(fields: [routeId], references: [id], onDelete: SetNull)
  allowedVehicleClasses TransferVehicleClass[] @map("allowed_vehicle_classes")
  tripType              TransferTripType?      @map("trip_type")

  // TOUR
  tourId               String?  @map("tour_id")
  tour                 Tour?    @relation(fields: [tourId], references: [id], onDelete: SetNull)
  allowedTourOptionIds String[] @map("allowed_tour_option_ids")

  // SERVICE
  serviceId String?  @map("service_id")
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  // Kosher overrides of the package profile, for a HOTEL_STAY slot.
  kosherMinServiceLevel     KosherServiceLevel?        @map("kosher_min_service_level")
  kosherCertifiedRequired   Boolean?                   @map("kosher_certified_required")
  kosherCertificationScopes KosherCertificationScope[] @map("kosher_certification_scopes")

  constraints Json @default("{}")

  @@unique([packageId, slotIndex])
  @@index([hotelId])
  @@index([tourId])
  @@index([serviceId])
  @@map("package_components")
}

model PackageImage {
  id        String  @id @default(cuid())
  packageId String  @map("package_id")
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  fileAssetId String    @map("file_asset_id")
  fileAsset   FileAsset @relation("PackageImages", fields: [fileAssetId], references: [id], onDelete: Restrict)

  caption   String?
  sortOrder Int     @default(0) @map("sort_order")
  isCover   Boolean @default(false) @map("is_cover")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([packageId, fileAssetId])
  @@index([packageId, sortOrder])
  @@map("package_images")
}

model PackageTranslation {
  id        String  @id @default(cuid())
  packageId String  @map("package_id")
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  locale      String
  name        String?
  summary     String?
  description String[]

  @@unique([packageId, locale])
  @@map("package_translations")
}

/// What makes a package kosher: the minimum the hotel slots must meet, the
/// requests attached to every stay, and where Shabbat falls. Its existence is
/// the switch, exactly as HotelKosherProfile is for a property.
model KosherPackageProfile {
  id        String  @id @default(cuid())
  packageId String  @unique @map("package_id")
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  minServiceLevel             KosherServiceLevel         @default(FULL) @map("min_service_level")
  certifiedRequired           Boolean                    @default(true) @map("certified_required")
  certificationScopes         KosherCertificationScope[] @default([PROPERTY, KITCHEN]) @map("certification_scopes")
  requireCertValidThroughStay Boolean                    @default(true) @map("require_cert_valid_through_stay")

  /// Rate plans allowed on a hotel slot must carry one of these; empty = any.
  requiredMealPlanCodes MealPlanCode[] @map("required_meal_plan_codes")
  /// HotelBookingRequest codes attached to every hotel stay in the package.
  hotelRequestCodes     String[]       @map("hotel_request_codes")

  shabbatMode             ShabbatMode @default(SOLAR) @map("shabbat_mode")
  shabbatFixedStart       String?     @map("shabbat_fixed_start")
  shabbatFixedEnd         String?     @map("shabbat_fixed_end")
  candleLightingOffsetMin Int         @default(18) @map("candle_lighting_offset_min")
  havdalahOffsetMin       Int         @default(42) @map("havdalah_offset_min")

  noTransfersInShabbat Boolean @default(true) @map("no_transfers_in_shabbat")
  noToursOnShabbat     Boolean @default(true) @map("no_tours_on_shabbat")
  /// Festivals: [{ from, to, label }] as date-only strings.
  extraRestDays        Json    @default("[]") @map("extra_rest_days")

  supervisionAuthority String? @map("supervision_authority")
  notes                String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("kosher_package_profiles")
}

/// What a kosher package needs to know about a tour before it can be a slot.
model TourKosherProfile {
  id     String @id @default(cuid())
  tourId String @unique @map("tour_id")
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  kosherMealsAvailable Boolean @default(false) @map("kosher_meals_available")
  operatesOnShabbat    Boolean @default(false) @map("operates_on_shabbat")
  notes                String?

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tour_kosher_profiles")
}

/// The product-agnostic parent. A package becomes an order; each slot becomes
/// an item pointing at exactly one child booking. Standalone bookings are not
/// wrapped in orders (yet), and no child table carries an order id — the
/// unique foreign key on the item already says one child is one item.
model Order {
  id String @id @default(cuid())

  reference String @unique

  status OrderStatus

  idempotencyKey String? @unique @map("idempotency_key")

  partnerId      String?  @map("partner_id")
  partner        Partner? @relation("PartnerOrders", fields: [partnerId], references: [id], onDelete: SetNull)
  bookedByUserId String?  @map("booked_by_user_id")
  bookedByUser   User?    @relation("OrderBookedBy", fields: [bookedByUserId], references: [id], onDelete: SetNull)

  kind      OrderKind @default(PACKAGE)
  packageId String?   @map("package_id")
  package   Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  adults    Int
  childAges Int[]    @map("child_ages")
  rooms     Int      @default(1)

  currency            String @db.Char(3)
  componentsNetCents  Int    @map("components_net_cents")
  componentsSellCents Int    @map("components_sell_cents")
  adjustmentCents     Int    @default(0) @map("adjustment_cents")
  sellTotalCents      Int    @map("sell_total_cents")
  /// The agency's own commission rate when it booked.
  commissionRateBps   Int?   @map("commission_rate_bps")

  leadName        String  @map("lead_name")
  leadEmail       String  @map("lead_email")
  leadPhone       String? @map("lead_phone")
  specialRequests String? @map("special_requests")

  packageSnapshot Json @map("package_snapshot")

  /// The earliest pending item's deadline, so the queue sorts on one column.
  requestDeadlineAt DateTime? @map("request_deadline_at")
  overdueAlertAt    DateTime? @map("overdue_alert_at")

  confirmedAt             DateTime? @map("confirmed_at")
  cancelledAt             DateTime? @map("cancelled_at")
  cancellationChargeCents Int?      @map("cancellation_charge_cents")
  cancellationReason      String?   @map("cancellation_reason")
  completedAt             DateTime? @map("completed_at")

  source String @default("web")

  items OrderItem[]

  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  /// Finance: what the buyer owes for the whole order.
  receivable Receivable?

  @@index([partnerId, createdAt])
  @@index([status, startDate])
  @@index([packageId])
  @@index([status, requestDeadlineAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  slotIndex     Int                  @map("slot_index")
  componentType PackageComponentType @map("component_type")
  label         String
  required      Boolean              @default(true)

  status     OrderItemStatus
  fulfilment OrderItemFulfilment @default(INTERNAL)

  hotelBookingId    String?          @unique @map("hotel_booking_id")
  hotelBooking      HotelBooking?    @relation(fields: [hotelBookingId], references: [id], onDelete: Restrict)
  transferBookingId String?          @unique @map("transfer_booking_id")
  transferBooking   TransferBooking? @relation(fields: [transferBookingId], references: [id], onDelete: Restrict)
  tourBookingId     String?          @unique @map("tour_booking_id")
  tourBooking       TourBooking?     @relation(fields: [tourBookingId], references: [id], onDelete: Restrict)
  serviceBookingId  String?          @unique @map("service_booking_id")
  serviceBooking    ServiceBooking?  @relation(fields: [serviceBookingId], references: [id], onDelete: Restrict)

  netCents        Int @map("net_cents")
  sellCents       Int @map("sell_cents")
  /// This item's share of the package adjustment, frozen at confirmation.
  adjustmentCents Int @default(0) @map("adjustment_cents")
  lineTotalCents  Int @map("line_total_cents")

  cancellationChargeCents Int?      @map("cancellation_charge_cents")
  cancelledAt             DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orderId, slotIndex])
  @@map("order_items")
}

model RoomType {
  id      String @id @default(cuid())
  hotelId String @map("hotel_id")
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  /// The supplier's own code for this room. Unique per hotel, and what a
  /// channel-manager mapping will key on later.
  code        String
  name        String
  description String?

  status      RoomTypeStatus @default(ACTIVE)
  sortOrder   Int            @default(0) @map("sort_order")
  roomSizeSqm Int?           @map("room_size_sqm")

  /// Occupancy. All four are stored and all four are checked, because
  /// maxOccupancy is not maxAdults + maxChildren: a room may allow two adults
  /// and two children but only three people in total.
  maxOccupancy Int @map("max_occupancy")
  maxAdults    Int @map("max_adults")
  maxChildren  Int @default(0) @map("max_children")
  minAdults    Int @default(1) @map("min_adults")

  /// The occupancy the base rate assumes. Anything above it prices as an extra
  /// person; anything below may qualify for a single-occupancy rate.
  standardOccupancy Int @default(2) @map("standard_occupancy")

  /// How many rollaways or cots can actually be put in the room. This is a
  /// physical fact about the room, not a pricing rule.
  extraBedCapacity Int @default(0) @map("extra_bed_capacity")

  bathroomType   BathroomType @default(PRIVATE) @map("bathroom_type")
  smokingAllowed Boolean      @default(false) @map("smoking_allowed")
  accessible     Boolean      @default(false)

  beds         RoomBed[]
  ratePlans    RatePlan[]
  inventory    RoomInventory[]
  holds        BookingHold[]
  bookingRooms HotelBookingRoom[]
  amenities    RoomTypeAmenity[]
  images       RoomTypeImage[]
  translations RoomTypeTranslation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([hotelId, code])
  @@index([hotelId, status])
  @@map("room_types")
}

/// The bed vocabulary. A reference table so that "1 King + 1 Sofa" is data a
/// search can reason about rather than a string a human has to read.
model BedType {
  id     String      @id @default(cuid())
  code   BedTypeCode @unique
  name   String
  /// How many people this bed sleeps. Summed to give a room's real capacity.
  sleeps Int         @default(1)
  icon   String?

  sortOrder Int @default(0) @map("sort_order")

  rooms RoomBed[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bed_types")
}

/// One line of a bed configuration: "2 x Twin".
///
/// `groupIndex` expresses *alternatives*. Group 0 might be one King plus a sofa
/// bed and group 1 two Twins plus a sofa bed — the same room, offered either
/// way. Without it, a room that can be made up as a double or a twin has to be
/// duplicated as two RoomTypes, and duplicated room types are exactly what
/// oversells inventory. The admin UI only writes group 0 today; the column
/// means adding the choice later is a UI change, not a migration.
model RoomBed {
  id         String   @id @default(cuid())
  roomTypeId String   @map("room_type_id")
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  bedTypeId  String   @map("bed_type_id")
  bedType    BedType  @relation(fields: [bedTypeId], references: [id], onDelete: Restrict)

  quantity   Int @default(1)
  groupIndex Int @default(0) @map("group_index")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([roomTypeId, groupIndex, bedTypeId])
  @@index([bedTypeId])
  @@map("room_beds")
}

model RoomTypeAmenity {
  roomTypeId String   @map("room_type_id")
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenityId  String   @map("amenity_id")
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  note String?

  createdAt DateTime @default(now()) @map("created_at")

  @@id([roomTypeId, amenityId])
  @@index([amenityId])
  @@map("room_type_amenities")
}

model RoomTypeImage {
  id          String    @id @default(cuid())
  roomTypeId  String    @map("room_type_id")
  roomType    RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  fileAssetId String    @map("file_asset_id")
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  caption   String?
  sortOrder Int     @default(0) @map("sort_order")
  /// At most one per room type, enforced by a partial unique index.
  isCover   Boolean @default(false) @map("is_cover")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([roomTypeId, fileAssetId])
  @@index([roomTypeId, sortOrder])
  @@map("room_type_images")
}

model RoomTypeTranslation {
  id         String   @id @default(cuid())
  roomTypeId String   @map("room_type_id")
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  locale     String

  name        String?
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([roomTypeId, locale])
  @@map("room_type_translations")
}

/// How a property treats children.
///
/// Platform defaults are seeded for every hotel (infant 0-2, child 3-11, adult
/// 12+) and any hotel may override them. Age is always evaluated at check-in;
/// a child having a birthday mid-stay does not reprice, which is the industry
/// norm and is stated explicitly so nobody has to guess later.
model ChildPolicy {
  id      String @id @default(cuid())
  hotelId String @unique @map("hotel_id")
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  infantMaxAge Int @default(2) @map("infant_max_age")
  childMaxAge  Int @default(11) @map("child_max_age")

  /// Whether an infant takes one of the room's occupancy slots. Usually not —
  /// a cot is not a bed — and getting this wrong silently shrinks every family
  /// room in the catalogue.
  childrenCountTowardOccupancy Boolean @default(false) @map("children_count_toward_occupancy")

  maxChildrenFreePerRoom Int? @map("max_children_free_per_room")

  bands ChildPolicyBand[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("child_policies")
}

model ChildPolicyBand {
  id            String      @id @default(cuid())
  childPolicyId String      @map("child_policy_id")
  childPolicy   ChildPolicy @relation(fields: [childPolicyId], references: [id], onDelete: Cascade)

  minAge Int    @map("min_age")
  maxAge Int    @map("max_age")
  label  String

  chargeMode  ChildChargeMode @default(FREE) @map("charge_mode")
  /// Basis points for PERCENT_OF_ADULT, minor units for FIXED_PER_NIGHT,
  /// ignored otherwise.
  chargeValue Int             @default(0) @map("charge_value")

  requiresExtraBed Boolean @default(false) @map("requires_extra_bed")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([childPolicyId, minAge])
  @@map("child_policy_bands")
}

// ---------------------------------------------------------------------------
// The commercial model.
//
// RatePlan is the join point of the whole thing: a RoomType sold with a
// particular board, under particular cancellation terms, on particular payment
// terms. It is the unit a guest actually books.
//
// The alternative — flattening `breakfastIncluded` and a `cancellation` string
// onto the room, as the prototype did — forces a duplicate RoomType for every
// commercial variant. Duplicate room types then duplicate inventory, and
// duplicated inventory oversells. That is the whole reason this table exists.
//
// Cancellation rules are structured rather than prose so a refund can be
// computed rather than read. The customer-facing description is kept alongside,
// because the two serve different readers.
// ---------------------------------------------------------------------------

model MealPlan {
  id          String       @id @default(cuid())
  code        MealPlanCode @unique
  name        String
  description String?
  sortOrder   Int          @default(0) @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")

  hotels    HotelMealPlan[]
  ratePlans RatePlan[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("meal_plans")
}

/// What a particular property means by a board code.
///
/// "HB" is a standard; "Dinner 18:00-21:30, drinks not included" is this
/// hotel's version of it. Both are needed — the code to compare across
/// properties, the prose to set expectations for the guest.
model HotelMealPlan {
  id         String   @id @default(cuid())
  hotelId    String   @map("hotel_id")
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  mealPlanId String   @map("meal_plan_id")
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Restrict)

  description  String?
  inclusions   String[]
  /// { breakfast: "07:00-10:00", dinner: "18:00-21:30" }
  serviceTimes Json     @default("{}") @map("service_times")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([hotelId, mealPlanId])
  @@index([mealPlanId])
  @@map("hotel_meal_plans")
}

/// A cancellation policy, as rules a computer can evaluate.
///
/// `hotelId` is nullable: a null policy is a platform template every hotel can
/// start from, so a new property is not faced with a blank form.
model CancellationPolicy {
  id      String  @id @default(cuid())
  hotelId String? @map("hotel_id")
  hotel   Hotel?  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  name String
  kind CancellationKind

  /// What the guest reads. The rules decide the money; this decides the
  /// wording, and neither is derived from the other.
  description String?
  isActive    Boolean @default(true) @map("is_active")

  rules            CancellationRule[]
  ratePlans        RatePlan[]
  transferVehicles TransferVehicle[]
  tourOptions      TourOption[]

  services  Service[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([hotelId, isActive])
  @@map("cancellation_policies")
}

/// One tier of a policy: "from this many hours before check-in and inward,
/// this much is charged".
///
/// Hours rather than days because a deadline is a wall-clock instant at the
/// property — "14 days before" means 14 days before check-in *time*, and
/// storing days would leave the time of day to be guessed at cancellation.
model CancellationRule {
  id       String             @id @default(cuid())
  policyId String             @map("policy_id")
  policy   CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  hoursBeforeCheckIn Int         @map("hours_before_check_in")
  chargeBasis        ChargeBasis @map("charge_basis")
  /// Basis points for the PERCENT_* bases, minor units for FIXED_AMOUNT, a
  /// count of nights for NIGHTS.
  chargeValue        Int         @map("charge_value")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([policyId, hoursBeforeCheckIn])
  @@map("cancellation_rules")
}

model PaymentPolicy {
  id      String  @id @default(cuid())
  hotelId String? @map("hotel_id")
  hotel   Hotel?  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  name   String
  timing PaymentTiming

  /// Deposit as basis points of the total, for DEPOSIT timing.
  depositBps                  Int? @map("deposit_bps")
  balanceDueDaysBeforeCheckIn Int? @map("balance_due_days_before_check_in")

  description String?
  isActive    Boolean @default(true) @map("is_active")

  ratePlans RatePlan[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hotelId, isActive])
  @@map("payment_policies")
}

/// The sellable offer.
model RatePlan {
  id         String   @id @default(cuid())
  roomTypeId String   @map("room_type_id")
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  code       String
  name       String
  status     RatePlanStatus     @default(ACTIVE)
  visibility RatePlanVisibility @default(PUBLIC)
  sortOrder  Int                @default(0) @map("sort_order")

  mealPlanId String   @map("meal_plan_id")
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Restrict)

  cancellationPolicyId String             @map("cancellation_policy_id")
  cancellationPolicy   CancellationPolicy @relation(fields: [cancellationPolicyId], references: [id], onDelete: Restrict)

  paymentPolicyId String        @map("payment_policy_id")
  paymentPolicy   PaymentPolicy @relation(fields: [paymentPolicyId], references: [id], onDelete: Restrict)

  /// ISO-4217, and the currency every Rate under this plan is quoted in.
  currency String @db.Char(3)

  /// The occupancy the base rate covers. Above it, extra-person pricing
  /// applies; below it, a single-occupancy rate may.
  baseOccupancy Int  @default(2) @map("base_occupancy")
  minAdults     Int? @map("min_adults")
  maxAdults     Int? @map("max_adults")
  maxChildren   Int? @map("max_children")

  /// When this plan may be sold at all, as opposed to which nights it covers.
  sellableFrom  DateTime? @map("sellable_from") @db.Date
  sellableUntil DateTime? @map("sellable_until") @db.Date

  restrictions RatePlanRestriction[]
  rates        Rate[]
  holds        BookingHold[]
  bookingRooms HotelBookingRoom[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([roomTypeId, code])
  @@index([roomTypeId, status])
  @@index([mealPlanId])
  @@map("rate_plans")
}

/// Booking restrictions that vary by date.
///
/// Restrictions that essentially never vary — occupancy caps — stay as columns
/// on the plan. These are the ones a revenue manager changes for a weekend or a
/// holiday: a two-night minimum over New Year, no arrivals on a changeover day.
model RatePlanRestriction {
  id         String   @id @default(cuid())
  ratePlanId String   @map("rate_plan_id")
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  minStay           Int?    @map("min_stay")
  maxStay           Int?    @map("max_stay")
  minAdvanceDays    Int?    @map("min_advance_days")
  maxAdvanceDays    Int?    @map("max_advance_days")
  /// Closed to arrival / departure: the stay may span this date but may not
  /// begin or end on it. Changeover days at ski resorts work exactly this way.
  closedToArrival   Boolean @default(false) @map("closed_to_arrival")
  closedToDeparture Boolean @default(false) @map("closed_to_departure")
  stopSell          Boolean @default(false) @map("stop_sell")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ratePlanId, startDate, endDate])
  @@map("rate_plan_restrictions")
}

// ---------------------------------------------------------------------------
// Inventory and pricing: one row per night.
//
// These are the two tables everything else in the module exists to serve, and
// the two that grow: a thousand hotels with five room types, three rate plans
// and a two-year horizon is roughly eleven million rate rows. Both are
// therefore deliberately narrow, and both are keyed by (parent, date) with no
// separate id — the natural key is the only key anything ever looks them up by,
// and dropping the surrogate saves a column and an index on every row.
//
// Availability is NOT stored. `total - blocked - booked - held` is derived on
// read, because a fifth number is a fifth thing that can disagree with the
// other four. What *is* stored is a CHECK constraint saying those four can
// never add up to an oversell, which is the last line of defence beneath the
// conditional UPDATE the booking path uses.
// ---------------------------------------------------------------------------

model RoomInventory {
  roomTypeId String   @map("room_type_id")
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  /// A calendar night at the property, never an instant.
  date       DateTime @db.Date

  totalUnits   Int @map("total_units")
  /// Out of service: maintenance, owner use, a room held back for staff.
  blockedUnits Int @default(0) @map("blocked_units")
  bookedUnits  Int @default(0) @map("booked_units")
  /// Checkout in progress. A counter rather than a join to booking_holds so
  /// that the no-oversell CHECK can see it; the sweeper keeps it honest.
  heldUnits    Int @default(0) @map("held_units")

  stopSell          Boolean @default(false) @map("stop_sell")
  minStay           Int?    @map("min_stay")
  closedToArrival   Boolean @default(false) @map("closed_to_arrival")
  closedToDeparture Boolean @default(false) @map("closed_to_departure")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([roomTypeId, date])
  @@index([date])
  @@map("room_inventory")
}

/// The price of one rate plan on one night.
///
/// Seasonal, weekend and holiday pricing are all just rows with different
/// values — there is no season engine and no rule evaluation at request time.
/// The bulk editors generate the rows; the read path stays an indexed range
/// scan.
model Rate {
  ratePlanId String   @map("rate_plan_id")
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date

  currency String @db.Char(3)

  /// What the supplier charges us. Never serialized to a guest.
  netCents  Int  @map("net_cents")
  /// A fixed selling price that overrides the markup. Null means derive.
  sellCents Int? @map("sell_cents")

  extraAdultCents      Int? @map("extra_adult_cents")
  extraChildCents      Int? @map("extra_child_cents")
  /// Used when one guest occupies a room priced for two.
  singleOccupancyCents Int? @map("single_occupancy_cents")

  /// Priced but not for sale on this date.
  closed Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([ratePlanId, date])
  @@index([date])
  @@map("rates")
}

/// Taxes and fees a property adds on top of the room rate.
///
/// Modelled now rather than later because a booking freezes its totals, and
/// retrofitting a tax into snapshots that were taken without one is not
/// possible. `includedInRate` is what decides whether the guest has already
/// paid it or owes it at the desk, and getting that wrong is a complaint at
/// check-out rather than a rounding error.
model HotelTaxFee {
  id      String @id @default(cuid())
  hotelId String @map("hotel_id")
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  name  String
  basis TaxFeeBasis
  /// Basis points for PERCENT, minor units otherwise.
  value Int

  currency String @db.Char(3)

  includedInRate    Boolean @default(false) @map("included_in_rate")
  appliesToChildren Boolean @default(true) @map("applies_to_children")

  /// Optional seasonal window; null on both means always.
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hotelId])
  @@map("hotel_tax_fees")
}

// ---------------------------------------------------------------------------
// Holds and bookings.
//
// Two ideas carry this whole section:
//
//   1. **A hold is a claim on inventory, and the counter is the enforcement.**
//      `room_inventory.held_units` is what the no-oversell CHECK can see; the
//      hold row is the record of who holds it and until when. The sweeper keeps
//      the two in step, and the reconciler proves they are.
//
//   2. **A booking is a snapshot, not a join.** Hotels rename rooms, retire rate
//      plans and tighten cancellation terms. A booking has to keep saying what
//      was sold, at what price, under what conditions — six months later, after
//      all of that has changed. So the foreign keys are there for reporting and
//      the snapshot is there for truth.
// ---------------------------------------------------------------------------

/// Inventory claimed by a checkout in progress.
model BookingHold {
  id    String @id @default(cuid())
  token String @unique

  roomTypeId String   @map("room_type_id")
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlanId String   @map("rate_plan_id")
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  checkIn  DateTime @map("check_in") @db.Date
  checkOut DateTime @map("check_out") @db.Date
  quantity Int      @default(1)

  adults    Int
  childAges Int[] @map("child_ages")

  /// What was quoted when the hold was taken. Compared against a fresh quote at
  /// confirmation, so a price that moved is a question rather than a surprise.
  quotedNetCents  Int    @map("quoted_net_cents")
  quotedSellCents Int    @map("quoted_sell_cents")
  currency        String @db.Char(3)

  status    HoldStatus @default(ACTIVE)
  expiresAt DateTime   @map("expires_at")

  bookingId String?       @unique @map("booking_id")
  booking   HotelBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdByUserId String?  @map("created_by_user_id")
  createdByUser   User?    @relation("HoldCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  partnerId       String?  @map("partner_id")
  partner         Partner? @relation("PartnerHolds", fields: [partnerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The sweeper's index: find every ACTIVE hold past its expiry, cheaply.
  @@index([status, expiresAt])
  @@index([roomTypeId, checkIn])
  @@map("booking_holds")
}

model HotelBooking {
  id String @id @default(cuid())

  /// The public reference, e.g. BKG-000001. Drawn from a Postgres sequence and
  /// never the primary key — an id is an implementation detail that must not
  /// appear in something a guest quotes over the phone.
  reference String @unique

  status HotelBookingStatus @default(PENDING)

  /// Derived from the request, unique, and what makes a retried confirmation
  /// return the original booking instead of making a second one.
  idempotencyKey String? @unique @map("idempotency_key")

  /// The buyer. Null for a direct guest booking, set for a B2B partner.
  partnerId      String?  @map("partner_id")
  partner        Partner? @relation("PartnerBookings", fields: [partnerId], references: [id], onDelete: SetNull)
  bookedByUserId String?  @map("booked_by_user_id")
  bookedByUser   User?    @relation("BookingBookedBy", fields: [bookedByUserId], references: [id], onDelete: SetNull)

  /// Kept for reporting. `hotelSnapshot` is what the voucher reads.
  hotelId String @map("hotel_id")
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  checkIn  DateTime @map("check_in") @db.Date
  checkOut DateTime @map("check_out") @db.Date
  nights   Int

  currency               String @db.Char(3)
  netTotalCents          Int    @map("net_total_cents")
  sellTotalCents         Int    @map("sell_total_cents")
  taxTotalCents          Int    @default(0) @map("tax_total_cents")
  payableAtPropertyCents Int    @default(0) @map("payable_at_property_cents")
  markupBps              Int    @map("markup_bps")
  /// The agency's own commission rate when it booked, beside the markup actually applied (a pricing rule may have won).
  commissionRateBps      Int?   @map("commission_rate_bps")

  /// Reserved for partner-currency quoting: the rate used, and when it was
  /// taken. Without them an invoice cannot be reproduced after the rate moves.
  fxRate   Decimal?  @map("fx_rate") @db.Decimal(18, 8)
  fxRateAt DateTime? @map("fx_rate_at")

  leadGuestName   String  @map("lead_guest_name")
  leadGuestEmail  String  @map("lead_guest_email")
  leadGuestPhone  String? @map("lead_guest_phone")
  specialRequests String? @map("special_requests")

  /// Name, address, phone, check-in times and time zone as they were. A voucher
  /// printed next year must still describe the property that was booked.
  hotelSnapshot Json @map("hotel_snapshot")

  confirmedAt             DateTime? @map("confirmed_at")
  cancelledAt             DateTime? @map("cancelled_at")
  cancellationChargeCents Int?      @map("cancellation_charge_cents")
  cancellationReason      String?   @map("cancellation_reason")
  /// Stamped by the completion sweep once check-out has passed. Tours and
  /// services carry the same column; an order completes only when every
  /// part has.
  completedAt             DateTime? @map("completed_at")

  /// Where it came from: web, partner API, admin.
  source String @default("web")

  rooms    HotelBookingRoom[]
  hold     BookingHold?
  requests HotelBookingRequest[]

  orderItem  OrderItem?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  /// Finance: what we owe the supplier, and what the buyer owes us (standalone bookings only).
  payable    SupplierPayable?
  receivable Receivable?

  @@index([hotelId, checkIn])
  @@index([partnerId, createdAt])
  @@index([status, checkIn])
  @@map("hotel_bookings")
}

/// One room, as it was sold.
model HotelBookingRoom {
  id        String       @id @default(cuid())
  bookingId String       @map("booking_id")
  booking   HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// SetNull, not Restrict: these are for reporting. If a room type is ever
  /// hard-deleted the booking must survive, which is what the snapshot is for.
  roomTypeId String?   @map("room_type_id")
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  ratePlanId String?   @map("rate_plan_id")
  ratePlan   RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)

  roomTypeName         String  @map("room_type_name")
  ratePlanName         String  @map("rate_plan_name")
  mealPlanCode         String  @map("meal_plan_code")
  mealPlanName         String  @map("meal_plan_name")
  bedConfigurationText String? @map("bed_configuration_text")

  adults    Int
  childAges Int[] @map("child_ages")

  netSubtotalCents  Int @map("net_subtotal_cents")
  sellSubtotalCents Int @map("sell_subtotal_cents")

  /// What the guest was told, in words.
  cancellationSummary String? @map("cancellation_summary")

  /// The tiers, resolved to absolute instants at the moment of confirmation.
  /// This is the single most important snapshot in the system: cancelling is a
  /// lookup here, so a hotel that tightens its terms in March cannot change
  /// what a guest who booked in January is owed.
  cancellationSchedule Json @map("cancellation_schedule")

  status BookingRoomStatus @default(CONFIRMED)

  nights HotelBookingNight[]
  guests BookingGuest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([bookingId])
  @@index([roomTypeId])
  @@map("hotel_booking_rooms")
}

/// The price of each night, frozen.
///
/// A total alone cannot support a partial cancellation, an amendment that drops
/// a night, or an invoice line — all of which need to know what each night cost.
model HotelBookingNight {
  bookingRoomId String           @map("booking_room_id")
  bookingRoom   HotelBookingRoom @relation(fields: [bookingRoomId], references: [id], onDelete: Cascade)
  date          DateTime         @db.Date

  netCents  Int @map("net_cents")
  sellCents Int @map("sell_cents")
  taxCents  Int @default(0) @map("tax_cents")

  createdAt DateTime @default(now()) @map("created_at")

  @@id([bookingRoomId, date])
  @@map("hotel_booking_nights")
}

model BookingGuest {
  id            String           @id @default(cuid())
  bookingRoomId String           @map("booking_room_id")
  bookingRoom   HotelBookingRoom @relation(fields: [bookingRoomId], references: [id], onDelete: Cascade)

  type      BookingGuestType @default(ADULT)
  firstName String           @map("first_name")
  lastName  String           @map("last_name")
  /// Age at check-in, frozen. A birthday during the stay does not reprice.
  age       Int?
  isLead    Boolean          @default(false) @map("is_lead")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([bookingRoomId])
  @@map("booking_guests")
}

/// A structured requirement attached to a booking.
///
/// Deliberately generic — `code` is a machine key from the shared vocabulary,
/// so "late checkout" and "adjoining rooms" will use this table too rather than
/// each growing a column of its own.
///
/// This is **not** a hotel capability. A capability says the property *can*; a
/// request says this guest *needs*, and carries the property's answer to it.
/// Conflating the two is how an agency ends up told a meal is confirmed because
/// the hotel once ticked a box.
///
/// The code is stored as a string rather than a foreign key, following the same
/// discipline as `mealPlanCode` on HotelBookingRoom: an amenity renamed next
/// year must not change what this booking asked for.
model HotelBookingRequest {
  id        String       @id @default(cuid())
  bookingId String       @map("booking_id")
  booking   HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  code String
  note String?

  status BookingRequestStatus @default(REQUESTED)

  respondedAt       DateTime? @map("responded_at")
  respondedByUserId String?   @map("responded_by_user_id")
  respondedBy       User?     @relation("BookingRequestRespondedBy", fields: [respondedByUserId], references: [id], onDelete: SetNull)
  responseNote      String?   @map("response_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([bookingId, code])
  @@index([bookingId, status])
  @@map("hotel_booking_requests")
}

/// Who pays what markup.
///
/// The resolver behind `resolveMarkupBps` has always been a seam: every caller
/// went through it while it simply returned the partner commission rate. This
/// table is what fills it in, and adding it changed no call site.
///
/// A rule matches when every field it *does* set matches the request; a null
/// field means "any". The most specific match wins, so a rate negotiated for
/// one partner at one hotel beats that partner's blanket rate, which beats the
/// hotel default, which beats the platform default. `priority` breaks ties
/// between rules of equal specificity, highest first.
model PricingRule {
  id String @id @default(cuid())

  /// The buyer. Null means the rule applies to every buyer.
  partnerId String?  @map("partner_id")
  partner   Partner? @relation("PartnerPricingRules", fields: [partnerId], references: [id], onDelete: Cascade)

  hotelId String? @map("hotel_id")
  hotel   Hotel?  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  destinationId String?      @map("destination_id")
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  /// The product dimensions. A rule may name one product (a hotel, a tour, a
  /// service or a package) or a whole product type; null means any. Named
  /// products beat a type, a type beats nothing — see `specificity` in
  /// services/hotel/pricingRule.service.js.
  productType PricingProductType? @map("product_type")

  tourId String? @map("tour_id")
  tour   Tour?   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  serviceId String?  @map("service_id")
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  packageId String?  @map("package_id")
  package   Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  /// Basis points added to the net rate: 1500 = 15%.
  markupBps Int @map("markup_bps")

  label    String?
  priority Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  validFrom  DateTime? @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([partnerId, isActive])
  @@index([hotelId, isActive])
  @@index([tourId, isActive])
  @@index([serviceId, isActive])
  @@index([packageId, isActive])
  @@map("pricing_rules")
}

// ---------------------------------------------------------------------------
// Amenities, media and translations.
//
// Three conventions worth stating, because each replaces something the
// prototype did inline:
//   * Amenities are rows, not an enum array. Filtering "hotels with a pool" is
//     then an index scan on a join table, and adding one is an INSERT rather
//     than a schema migration.
//   * Media is a FileAsset plus typed join tables. A single polymorphic
//     association table was rejected: it cannot carry a foreign key, so an
//     orphan would be undetectable and every cascade would be hand-written.
//   * Translations are per-entity tables with every prose field nullable, so a
//     missing translation degrades to English for that one field. This is the
//     contract client/data/i18n/merge.ts already implements.
// ---------------------------------------------------------------------------

model Amenity {
  id       String          @id @default(cuid())
  /// Stable machine key, e.g. `skiStorage`. Referenced by seeds and by the
  /// client icon map, so renaming one is a data migration.
  code     String          @unique
  name     String
  category AmenityCategory
  scope    AmenityScope    @default(HOTEL)
  /// Icon identifier the client resolves. Never a URL and never an SVG blob.
  icon     String?

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  hotels       HotelAmenity[]
  roomTypes    RoomTypeAmenity[]
  translations AmenityTranslation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category, isActive])
  @@map("amenities")
}

model HotelAmenity {
  hotelId   String  @map("hotel_id")
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenityId String  @map("amenity_id")
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  /// Per-property qualifier: "Parking, 15 GEL per night", "Pool, summer only".
  note String?

  createdAt DateTime @default(now()) @map("created_at")

  @@id([hotelId, amenityId])
  @@index([amenityId])
  @@map("hotel_amenities")
}

/// One uploaded object. The row holds metadata and an object key; the bytes
/// live in object storage. There is deliberately no URL column: a public URL is
/// composed from config at serialization time and a private one is signed on
/// demand, so changing CDN or provider is a config change, not a migration.
model FileAsset {
  id String @id @default(cuid())

  /// Generated, never derived from the upload. This is what makes path
  /// traversal, filename collisions and unicode filename tricks impossible.
  objectKey String @unique @map("object_key")
  bucket    String

  /// Kept for display in the admin panel only. Never used to build a key.
  originalFilename String @map("original_filename")
  /// The sniffed type, not the declared one.
  mimeType         String @map("mime_type")
  sizeBytes        Int    @map("size_bytes")
  checksumSha256   String @map("checksum_sha256")

  width  Int?
  height Int?

  category   FileCategory
  visibility FileVisibility

  /// PENDING while variants are still being written, READY once usable, FAILED
  /// when processing gave up. Readers filter on READY.
  status String @default("PENDING")

  altText String? @map("alt_text")

  uploadedByUserId String? @map("uploaded_by_user_id")
  uploadedByUser   User?   @relation("FileUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  /// Owning company, for supplier authorization. Null means platform-owned.
  partnerId String?  @map("partner_id")
  partner   Partner? @relation("PartnerFiles", fields: [partnerId], references: [id], onDelete: SetNull)

  /// Soft delete: an asset referenced by a booking voucher must not vanish
  /// because someone tidied a gallery.
  deletedAt DateTime? @map("deleted_at")

  variants          ImageVariant[]
  hotelImages       HotelImage[]
  roomTypeImages    RoomTypeImage[]
  hotelDocuments    HotelDocument[]
  featuredForHotels Hotel[]         @relation("HotelFeaturedImage")
  contractOf        Partner?        @relation("PartnerContract")

  fleetVehicleImages    TransferFleetVehicleImage[]    @relation("FleetVehicleImages")
  fleetVehicleDocuments TransferFleetVehicleDocument[] @relation("FleetVehicleDocuments")
  mainImageForFleet     TransferFleetVehicle[]         @relation("FleetVehicleMainImage")
  driverDocuments       TransferDriverDocument[]       @relation("DriverDocuments")
  driverPhotos          TransferDriver[]               @relation("DriverPhoto")
  tourImages            TourImage[]                    @relation("TourImages")

  packageImages      PackageImage[]  @relation("PackageImages")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  paymentAttachments PaymentRecord[] @relation("PaymentAttachments")

  @@index([category, visibility])
  @@index([partnerId])
  @@index([checksumSha256])
  @@index([status])
  @@map("file_assets")
}

/// A derived rendition of an image: one row per size and format. Stored rather
/// than resized on request, so the CDN serves a real object.
model ImageVariant {
  id          String    @id @default(cuid())
  fileAssetId String    @map("file_asset_id")
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  /// thumb | card | gallery | original
  variant   String
  /// webp | avif | jpeg
  format    String
  objectKey String @unique @map("object_key")

  width     Int
  height    Int
  sizeBytes Int @map("size_bytes")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([fileAssetId, variant, format])
  @@map("image_variants")
}

model HotelImage {
  id          String    @id @default(cuid())
  hotelId     String    @map("hotel_id")
  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  fileAssetId String    @map("file_asset_id")
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  category  ImageCategory @default(Exterior)
  caption   String?
  sortOrder Int           @default(0) @map("sort_order")
  /// At most one per hotel, enforced by a partial unique index in the
  /// migration. Prisma cannot express an index with a WHERE clause.
  isCover   Boolean       @default(false) @map("is_cover")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([hotelId, fileAssetId])
  @@index([hotelId, sortOrder])
  @@map("hotel_images")
}

/// Contracts, rate sheets and anything else that must never have a public URL.
model HotelDocument {
  id          String    @id @default(cuid())
  hotelId     String    @map("hotel_id")
  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  fileAssetId String    @map("file_asset_id")
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  docType    String    @map("doc_type")
  label      String?
  validUntil DateTime? @map("valid_until") @db.Date

  uploadedByUserId String? @map("uploaded_by_user_id")
  uploadedByUser   User?   @relation("HotelDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  kosherCertifications HotelKosherCertification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([hotelId, fileAssetId])
  @@index([hotelId, docType])
  @@index([uploadedByUserId])
  @@map("hotel_documents")
}

// ---------------------------------------------------------------------------
// Kosher.
//
// Three kinds of claim, kept apart because they are trusted differently:
//
//   * **Facilities** — "there is a Shabbat elevator" — are rows in `amenities`
//     under the KosherFood / Shabbat / Religious categories, reached through
//     the ordinary HotelAmenity join. They are the property's own statement,
//     they are filterable through machinery that already exists, and adding
//     one is a seed row rather than a migration.
//   * **Scope of service** — how much of the property is kosher — is
//     `HotelKosherProfile.serviceLevel`, declared by staff.
//   * **Assurance** — who says so, and until when — is a certificate, and is
//     the only thing that may ever produce the word "certified".
//
// The split is the point. An admin cannot mark a hotel kosher certified,
// because there is no such field to set: `certified` is computed from a
// VERIFIED, unexpired, unarchived certificate and from today's date.
// ---------------------------------------------------------------------------

/// A property's kosher offering.
///
/// The existence of this row IS the "this property provides Kosher services"
/// switch. No row means no kosher block in any response, no match for any
/// kosher filter, and no kosher section in the admin panel — enforced by data
/// rather than by a condition in a form.
model HotelKosherProfile {
  id      String @id @default(cuid())
  hotelId String @unique @map("hotel_id")
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  serviceLevel KosherServiceLevel @default(KOSHER_FRIENDLY) @map("service_level")

  /// What the property actually does, in prose, for an agent reading the page.
  notes String?

  /// Who to ask at the property about a kosher requirement. A booking request
  /// is worth little if nobody knows where to send it.
  contactName  String? @map("contact_name")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  // --- provenance ---------------------------------------------------------
  // Which of the four kinds of information this is. `Hotel.sourceType` says
  // which system owns *inventory*; nothing said who asserted a content fact,
  // and without that a future channel-manager sync has nothing to refuse to
  // overwrite.
  source          KosherDataSource @default(ADMIN)
  /// The upstream identifier this arrived under, when it arrived from one.
  sourceRef       String?          @map("source_ref")
  sourceUpdatedAt DateTime?        @map("source_updated_at")

  /// Set when staff have reviewed the record. A supplier import may not write
  /// a locked profile — it parks its payload in `pendingSupplierData` and logs
  /// the divergence for an admin, rather than quietly winning.
  lockedAt       DateTime? @map("locked_at")
  lockedByUserId String?   @map("locked_by_user_id")
  lockedBy       User?     @relation("KosherProfileLockedBy", fields: [lockedByUserId], references: [id], onDelete: SetNull)

  /// A supplier payload that could not be applied. Shapeless by nature — one
  /// channel manager's fields are not another's — so it is constrained to an
  /// object by `jsonFieldSchemas` and no further.
  pendingSupplierData Json? @map("pending_supplier_data")

  certifications HotelKosherCertification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([serviceLevel])
  @@map("hotel_kosher_profiles")
}

/// One certificate, as issued.
///
/// Never updated in place on renewal: a renewal is a new row, so last year's
/// certificate keeps its own dates and stays readable. Never hard-deleted once
/// VERIFIED — archived instead, because "we were certified by X until March"
/// is a fact somebody will eventually have to answer for.
model HotelKosherCertification {
  id        String             @id @default(cuid())
  profileId String             @map("profile_id")
  profile   HotelKosherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// The supervising organisation, as a proper noun. Deliberately free text and
  /// deliberately never translated: a badatz is a named real-world body, and
  /// enumerating the world's certifying authorities is not this platform's job.
  authorityName    String  @map("authority_name")
  authorityWebsite String? @map("authority_website")
  /// What the certificate is called, when it has a name of its own.
  name             String?
  /// The certificate number, for anyone checking it upstream.
  reference        String?

  scope KosherCertificationScope @default(PROPERTY)

  issuedOn  DateTime? @map("issued_on") @db.Date
  /// Null means the authority issues no expiry — a different thing from nobody
  /// having entered one, which is why the admin form makes it a deliberate
  /// choice. Anything else is compared against today on every single read.
  expiresOn DateTime? @map("expires_on") @db.Date

  verification      KosherVerification @default(UNVERIFIED)
  verifiedAt        DateTime?          @map("verified_at")
  verifiedByUserId  String?            @map("verified_by_user_id")
  verifiedBy        User?              @relation("KosherCertificationVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verificationNotes String?            @map("verification_notes")

  /// The scan or photograph, held through the document library so it inherits
  /// the private-file path: reaching the bytes is a signed, audited request.
  documentId String?        @map("document_id")
  document   HotelDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  source KosherDataSource @default(ADMIN)

  /// Historical rather than deleted. An archived certificate is invisible to
  /// filters and to the B2B card, and still readable in the admin panel.
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([profileId, verification])
  @@index([expiresOn])
  @@map("hotel_kosher_certifications")
}

/// Prose in a non-default locale. Every field is nullable and the serializer
/// merges only the ones that are set, so a half-finished translation reads
/// translated where it exists and English everywhere else. Nothing that is not
/// language, such as ids, slugs, prices or coordinates, is duplicated here.
model HotelTranslation {
  id      String @id @default(cuid())
  hotelId String @map("hotel_id")
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  locale  String

  name             String?
  shortDescription String?  @map("short_description")
  summary          String?
  description      String[]
  /// HotelPolicies
  policies         Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([hotelId, locale])
  @@map("hotel_translations")
}

model DestinationTranslation {
  id            String      @id @default(cuid())
  destinationId String      @map("destination_id")
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  locale        String

  name        String?
  tagline     String?
  summary     String?
  description String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([destinationId, locale])
  @@map("destination_translations")
}

model AmenityTranslation {
  id        String  @id @default(cuid())
  amenityId String  @map("amenity_id")
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  locale    String

  name String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([amenityId, locale])
  @@map("amenity_translations")
}

// ---------------------------------------------------------------------------
// Accounts, partners and the audit trail.
//
// Two conventions from above are deliberately broken here, both for the same
// reason — an audit trail that disappears with the record it describes is not
// an audit trail:
//   * AuditLog references its entity by plain (type, id) strings rather than a
//     foreign key, so deleting a partner leaves its history intact.
//   * Actor and reviewer foreign keys use onDelete: SetNull, not Cascade.
// Session and AuthToken store only the sha256 of a token, never the token, so
// a database dump cannot be replayed as a live link.
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  /// Platform staff who read everything, including margins, and write nothing.
  MANAGEMENT
  /// Platform staff who run the operation: bookings, tours, the fleet; never
  /// a hotel price, never a margin.
  TOUR_OPERATOR
  /// Platform staff who keep the books: payments, refunds, terms, reports.
  ACCOUNTANT
  /// Platform staff who confirm the day's payments and watch the debts;
  /// narrower than the accountant.
  FINANCE_OPERATOR
  /// Transfer operations staff: dispatches drivers and cars, never touches
  /// fares, partners or margins. Platform-side (no partnerId), not an admin.
  DISPATCHER
  PARTNER_OWNER
  PARTNER_ADMIN
  PARTNER_AGENT
  PARTNER_FINANCE
  /// A transfer driver. Platform-side (no partnerId): affiliation to a supplier
  /// lives on the TransferDriver profile, so partner scoping fails closed.
  DRIVER

  @@map("role")
}

enum PartnerStatus {
  INVITED
  REGISTRATION_IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  /// Access withdrawn by the platform; reversible, nothing else changes.
  BLOCKED
  /// The relationship is over: accounts deactivated, nothing reopens.
  TERMINATED

  @@map("partner_status")
}

enum PartnerKind {
  HOTEL
  TOUR_OPERATOR
  TRANSPORT
  EXPERIENCE

