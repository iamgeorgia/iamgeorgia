# Where the Express API lives. Read at build time and inlined into the browser
# bundle, so it must be the URL a visitor's browser can reach - not an internal
# hostname. The server must list this origin in its own CLIENT_ORIGIN, because
# the session cookie only travels cross-origin when CORS allows credentials.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google Maps, for the place search and map on the admin location screens and
# the pick-up address at transfer checkout. A browser key: it ships in the
# bundle, so it must be restricted in the Cloud console by HTTP referrer (this
# site's origins) and to the Maps JavaScript, Places (New) and Geocoding APIs.
# Leave it empty and those screens fall back to typed coordinates.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# A Map ID from the same console, for the map's styling and its markers.
# Optional: Google's DEMO_MAP_ID is used when this is empty.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Shared secret with the API (same name there). Lets server renders tell the API
# which visitor they are for, so per-IP rate limits count visitors, not this
# server. Never prefixed NEXT_PUBLIC_: it must stay out of the browser bundle.
API_CLIENT_TOKEN=

# The public cart: several products booked as one trip. "true" shows the bag
# in the header, the "Add to cart" buttons and the /cart pages; anything else
# hides all of them and /cart answers 404. Read at build time and inlined into
# the browser bundle. The API has its own switch of the same intent
# (CART_ENABLED) and its routes answer 404 CART_DISABLED while it is off, so
# both must be on for the cart to work.
NEXT_PUBLIC_CART_ENABLED=false
